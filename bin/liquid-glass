    ("peche", ["#ffe8cc", "#ffc994", "#ffa25f", "#e8723a", "#a8461f"]),
    ("glacier", ["#eef4fb", "#cfdcef", "#a5bddf", "#7194c4", "#3f659b"]),
    ("prune", ["#e3c5dd", "#c48fbc", "#995f95", "#6b3a6d", "#3c1d40"]),
    ("olive", ["#e5e2c3", "#c4c08c", "#9a955a", "#6b6936", "#3b3a1b"]),
]


def _wall_generate() -> None:
    import random
    WALL_DIR.mkdir(parents=True, exist_ok=True)
    W, H = 2560, 1440
    for name, cols in GEN_PALETTES:
        rng = random.Random(name)
        # 1. Vagues de papier : chaque calque est une courbe lisse, ombre douce au-dessus.
        dest = WALL_DIR / f"genere-vagues-{name}.jpg"
        if not dest.exists():
            args = ["-size", f"{W}x{H}", f"xc:{cols[0]}"]
            for i, c in enumerate(cols[1:], start=1):
                base = H * (0.2 + 0.17 * i)
                pts = []
                for k in range(0, 9):
                    x = -80 + k * (W + 160) / 8
                    pts.append(f"{x:.0f},{base + rng.uniform(-0.09, 0.09) * H:.0f}")
                path = f"M -80,{H + 80} L -80,{pts[0].split(',')[1]} " + " ".join(
                    f"S {pts[k]} {pts[k + 1] if k + 1 < len(pts) else pts[k]}" for k in range(1, len(pts), 2)) + f" L {W + 80},{H + 80} Z"
                # Ombre : le même calque en noir, remonté et flouté, à la même taille (pas de décalage).
                args += ["(", "-size", f"{W}x{H}", "xc:none", "-fill", "rgba(0,0,0,0.5)",
                         "-draw", f"translate 0,-16 path '{path}'", "-blur", "0x24", ")",
                         "-compose", "over", "-composite",
                         "-fill", c, "-draw", f"path '{path}'"]
            subprocess.run(["magick", *args, "-quality", "90", str(dest)])
        # 2. Taches floutées (dégradé « liquide »), avec un léger grain.
        dest = WALL_DIR / f"genere-fluide-{name}.jpg"
        if not dest.exists():
            draws = []
            # Du plus sombre au plus clair : les teintes claires restent au premier plan.
            for c in reversed(cols):
                cx, cy = rng.uniform(40, 600), rng.uniform(30, 330)
                rx, ry = rng.uniform(160, 320), rng.uniform(110, 220)
                draws += ["-fill", c, "-draw", f"ellipse {cx:.0f},{cy:.0f} {rx:.0f},{ry:.0f} 0,360"]
            subprocess.run(["magick", "-size", "640x360", f"xc:{cols[1]}", *draws, "-blur", "0x48",
                            "-resize", f"{W}x{H}!",
                            "(", "-size", f"{W}x{H}", "xc:gray50", "+noise", "Gaussian", "-colorspace", "gray",
                            "-evaluate", "multiply", "0.35", ")", "-compose", "overlay", "-composite",
                            "-quality", "90", str(dest)])
        print(f"  + {name}")


def cmd_wallpapers(args: list[str]) -> None:
    action = args[0] if args else "list"
    if action == "fetch":
        _wall_fetch()
    elif action == "generate":
        _wall_generate()
    elif action != "list":
        sys.exit("usage : liquid-glass wallpapers fetch|generate|list")
    # Visibles dans le sélecteur d'Omarchy et dans Réglages, pour les deux thèmes
    # (les liens vers des fonds supprimés ou renommés sont retirés).
    for theme in ("liquid-glass", "liquid-glass-dark"):
        link = Path.home() / ".config/omarchy/backgrounds" / theme
        link.mkdir(parents=True, exist_ok=True)
        for old in link.iterdir():
            if old.is_symlink() and not old.exists():
                old.unlink()
        for f in WALL_DIR.glob("*.jpg"):
            target = link / f.name
            if not target.exists():
                target.symlink_to(f)
    # Vignettes 480 px pour la grille de Réglages (200 fonds pleine taille seraient lents).
    thumbs = Path.home() / ".cache/liquid-glass/thumbs"
    thumbs.mkdir(parents=True, exist_ok=True)
    for f in WALL_DIR.glob("*.jpg"):
        t = thumbs / f.name
        if not t.exists():
            subprocess.run(["magick", str(f), "-thumbnail", "480x300^", "-gravity", "center", "-extent", "480x300",
                            "-quality", "82", str(t)], check=False)
    files = sorted(WALL_DIR.glob("*.jpg"))
    by: dict[str, int] = {}
    for f in files:
        by[f.name.split("-")[0]] = by.get(f.name.split("-")[0], 0) + 1
    print(f"{len(files)} fonds : " + ", ".join(f"{k} {v}" for k, v in sorted(by.items())))


# Fonds d'écran animés (façon fonds dynamiques macOS) : un panoramique lent et
# une respiration de teinte sur une période exacte → la boucle est parfaite.
# Le cadrage se fait sur une image deux fois plus grande puis réduite, ce qui
# donne un mouvement au demi-pixel (pas de saccades). Omarchy lit les vidéos
# de backgrounds/ comme fonds d'écran (sélecteur : double-clic sur le bureau).
ANIMATED = {
    # thème : [(source, sortie, amplitude du panoramique, période en s, teinte en °)]
    "liquid-glass": [
        ("03-monterey-light.jpg", "12-monterey-anime.mp4", 0.10, 30, 8),
        ("09-aurora-day.jpg", "13-aurore-animee.mp4", 0.12, 24, 14),
        ("07-big-sur.jpg", "14-big-sur-anime.mp4", 0.08, 30, 5),
    ],
    "liquid-glass-dark": [
        ("03-monterey-dark.jpg", "10-monterey-nuit-anime.mp4", 0.10, 30, 8),
        ("07-aurora-night.jpg", "11-aurore-nuit-animee.mp4", 0.12, 24, 16),
        ("02-big-sur-dark.jpg", "12-big-sur-nuit-anime.mp4", 0.08, 30, 5),
    ],
}


def cmd_animated_wallpapers(args: list[str]) -> None:
    if not shutil.which("ffmpeg"):
        sys.exit("ffmpeg est nécessaire (sudo pacman -S ffmpeg)")
    force = "--force" in args
    themes = Path(__file__).resolve().parent.parent / "themes"
    for theme, items in ANIMATED.items():
        bg = themes / theme / "backgrounds"
        if not bg.is_dir():
            continue
        for src, out, amp, period, hue in items:
            source, target = bg / src, bg / out
            if not source.exists() or (target.exists() and not force):
                continue
            W, H = 3840, 2160                       # rendu ×2, réduit en 1080p
            big_w, big_h = round(W * (1 + amp)), round(H * (1 + amp))
            dx, dy = big_w - W, big_h - H
            # Trajet en ellipse (cos/sin de même période) : départ = arrivée.
            vf = (f"scale={big_w}:{big_h}:flags=lanczos,"
                  f"crop={W}:{H}:x='{dx}/2*(1-cos(2*PI*t/{period}))':y='{dy}/2*(1+sin(2*PI*t/{period}))',"
                  f"scale=1920:1080:flags=bicubic,"
                  f"hue=h='{hue}*sin(2*PI*t/{period})':s='1+0.06*sin(4*PI*t/{period})',"
                  "format=yuv420p")
            tmp = target.with_suffix(".part.mp4")
            print(f"→ {theme}/{out}")
            r = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                                "-loop", "1", "-framerate", "24", "-t", str(period), "-i", str(source),
                                "-vf", vf, "-c:v", "libx264", "-preset", "medium", "-crf", "27",
                                "-tune", "stillimage", "-movflags", "+faststart", "-an", str(tmp)])
            if r.returncode == 0:
                tmp.replace(target)
            else:
                tmp.unlink(missing_ok=True)
                print(f"  échec ({src})", file=sys.stderr)
    # Vignettes pour Réglages → Fond d'écran (une image de chaque vidéo).
    posters = Path.home() / ".cache/liquid-glass/posters"
    posters.mkdir(parents=True, exist_ok=True)
    for theme, items in ANIMATED.items():
        for _src, out, *_ in items:
            video = themes / theme / "backgrounds" / out
            poster = posters / (Path(out).stem + ".jpg")
            if video.exists() and (force or not poster.exists()):
                subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", str(video),
                                "-frames:v", "1", "-vf", "scale=640:-2", str(poster)])
    print("Fonds animés prêts : double-clic sur le bureau pour choisir (ou Réglages → Fond d'écran).")


def cmd_tile_menu(args: list[str]) -> None:
    """Bouton vert des barres de titre : menu Plein écran / Mosaïque sous le curseur."""
    addr = args[0] if args else ""
    if addr and not addr.startswith("0x"):
        addr = "0x" + addr
    if not ADDR_RE.match(addr):
        addr = (_hypr_json("activewindow") or {}).get("address", "")
    if not ADDR_RE.match(addr):
        return
    pos = _hypr_json("cursorpos") or {}
    mons = _hypr_json("monitors") or []
    mon = next((m for m in mons if m.get("focused")), mons[0] if mons else {})
    x = int(pos.get("x", 0)) - int(mon.get("x", 0))
    y = int(pos.get("y", 0)) - int(mon.get("y", 0))
    run("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})')
    payload = json.dumps({"addr": addr, "x": x, "y": y})
    run("omarchy-shell", "shell", "summon", "liquid-glass.tilemenu", payload)


def cmd_resume_music(_args: list[str]) -> None:
    """Relance le dernier morceau Spotify (bouton ▶ de l'écran verrouillé / widget)."""
    import time
    last = {}
    try:
        last = json.loads((Path.home() / ".cache/liquid-glass/last-track.json").read_text())
    except Exception:
        pass
    uri = str(last.get("uri") or "")
    if not re.fullmatch(r"spotify:(track|episode):[A-Za-z0-9]+", uri):
        uri = ""

    def spotify_player() -> str:
        out = run("playerctl", "-l").stdout or ""
        return next((l.strip() for l in out.splitlines() if l.strip().startswith("spotify")), "")

    name = spotify_player()
    if not name:
        launcher = shutil.which("spotify-launcher") or shutil.which("spotify")
        if not launcher:
            sys.exit("Spotify n'est pas installé")
        subprocess.Popen(["uwsm-app", "--", launcher] if shutil.which("uwsm-app") else [launcher],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(60):
            time.sleep(0.5)
            name = spotify_player()
            if name:
                break
        if not name:
            sys.exit("Spotify ne répond pas")
        time.sleep(1.5)  # le temps que le lecteur charge sa session
    if uri:
        run("playerctl", "-p", name, "open", uri)
        time.sleep(1.2)
    if (run("playerctl", "-p", name, "status").stdout or "").strip() != "Playing":
        run("playerctl", "-p", name, "play")


def cmd_bar_contrast(args: list[str]) -> None:
    """Barre transparente (Tahoe) : texte sombre sur un fond clair, blanc sur un fond sombre.

    Mesure la luminance de la bande du haut du fond d'écran et règle [bar] text
    dans le thème courant (shell.toml), puis le recharge à chaud.
    """
    state = Path.home() / ".local/state/omarchy/current"
    shell_toml = state / "theme/shell.toml"
    if not shell_toml.exists():
        return
    try:
        bar_bg = json.loads((Path.home() / ".config/omarchy/shell.json").read_text()).get("bar", {}).get("background")
    except Exception:
        bar_bg = None
    text = shell_toml.read_text()
    m = re.search(r'(?ms)^\[bar\].*?^text\s*=\s*"(#[0-9a-fA-F]{6})"', text)
    if not m:
        return
    saved = CACHE_DIR / "bar-text-theme"
    if bar_bg != "none" and "--force" not in args:
        # Barre en verre ou opaque : la couleur du thème reprend ses droits.
        if saved.exists():
            want = saved.read_text().strip()
            saved.unlink()
        else:
            return
    else:
        img = Path(args[0]) if args and not args[0].startswith("-") else (state / "background").resolve()
        if not img.is_file():
            return
        r = run("magick", str(img), "-resize", "480x", "-gravity", "North", "-crop", "100%x5%+0+0",
                "-colorspace", "Gray", "-format", "%[fx:mean]", "info:")
        try:
            lum = float((r.stdout or "").strip())
        except ValueError:
            return
        want = "#1d1d1f" if lum > 0.6 else "#ffffff"
        if not saved.exists():
            saved.parent.mkdir(parents=True, exist_ok=True)
            saved.write_text(m.group(1))
    if m.group(1).lower() == want.lower():
        return
    shell_toml.write_text(text[:m.start(1)] + want + text[m.end(1):])
    flag = CACHE_DIR / "dynamic-colors-active"
    if flag.exists() and shutil.which("liquid-glass-spotify"):
        run("liquid-glass-spotify", "colors", "--accent", flag.read_text().strip())
    else:
        import base64
        b64 = lambda t: base64.b64encode(t.encode()).decode()
        colors = (state / "theme/colors.toml").read_text()
        run("omarchy-shell", "-q", "shell", "applyTheme", b64(colors), b64(shell_toml.read_text()))
    print(want)


def _desktop_file(app_id: str) -> Path | None:
    name = app_id if app_id.endswith(".desktop") else app_id + ".desktop"
    if "/" in name:
        return None
    dirs = [Path.home() / ".local/share/applications"]
    dirs += [Path(d) / "applications" for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if d]
    for d in dirs:
        if (d / name).is_file():
            return d / name
    return None


def cmd_login_item(args: list[str]) -> None:
    """Dock → Options → Ouvrir à la connexion : ~/.config/autostart (XDG, lancé par uwsm)."""
    if len(args) < 2 or args[1] not in ("on", "off", "toggle", "status") or not re.fullmatch(r"[\w.\-]+", args[0]):
        sys.exit("usage : liquid-glass login-item <app.desktop> on|off|toggle|status")
    app_id, act = args[0].removesuffix(".desktop"), args[1]
    target = Path.home() / ".config/autostart" / (app_id + ".desktop")
    on = target.exists()
    if act == "status":
        print("on" if on else "off")
        return
    want = (not on) if act == "toggle" else act == "on"
    if want and not on:
        src = _desktop_file(app_id)
        if not src:
            sys.exit(f"application introuvable : {app_id}")
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, target)
        run("notify-send", "-a", "Réglages Système", "-i", "system-run",
            "Élément d'ouverture ajouté", f"« {app_id} » s'ouvrira à la prochaine ouverture de session.")
    elif not want and on:
        target.unlink()
    print("on" if want else "off")


# ------------------------------------------------------------- profils (⌘⇧Espace)
# Deux bureaux qui n'ont rien en commun hormis les apps : « mac » (Liquid Glass)
# et « linux » (rice lain d'après github.com/Teiguuu/dotfiles). Chaque profil a
# son shell.json (plugins, barre), son thème Omarchy et son réglage Hyprland
# (hypr-vars.lua → profile). Les shell.json sont gardés dans profiles/ et
# échangés à chaque bascule ; le shell les recharge à chaud.
PROFILE_DIR = CONF_DIR / "profiles"
LINUX_THEME = "lain"   # thème de repli du style « expressive » (couleurs tirées du fond)
# Styles du bureau Linux et leur thème Omarchy (terminaux, bordures, fonds).
LINUX_STYLES = ["blanc", "sombre", "jouet", "violet", "expressive", "windows", "mono", "foret",
                "ruban", "espace", "cosmos", "ile", "gouts", "debian", "fedora", "mint", "kali", "arch"]
LINUX_THEMES = ["lain", "blanc", "sombre", "jouet", "violet", "violet-aube", "rose", "windows", "windows-sombre", "mono", "mono-papier",
                "mono-sakura", "foret", "ruban", "espace", "cosmos", "ile", "debian", "fedora", "mint", "kali", "arch"]
VIOLET_TONES = {"nuit": "violet", "aube": "violet-aube", "rose": "rose", "minuit": "violet"}
# Teintes de chaque style (un seul style, plusieurs couleurs) : clé de [linux] et valeurs.
STYLE_TONES = {
    "violet": ("violet_tone", ["nuit", "aube", "rose", "minuit"]),
    "blanc": ("blanc_tone", ["pur", "creme"]),
    "sombre": ("sombre_tone", ["encre", "ambre", "glace", "sang", "indigo"]),
    "jouet": ("jouet_tone", ["bonbon", "menthe", "peche", "lagon", "lilas"]),
    "foret": ("foret_tone", ["mousse", "cendre"]),
    "mono": ("mono_tone", ["noir", "papier", "sakura"]),
    "ruban": ("ruban_tone", ["bleu", "rouge", "or", "vert", "violet"]),
    "espace": ("espace_tone", ["bleu", "mars", "nebuleuse", "aurore", "soleil"]),
    "cosmos": ("cosmos_tone", ["orbite", "mousse", "corail"]),
    "windows": ("windows_tone", ["clair", "sombre"]),
    "expressive": ("scheme", ["tonal-spot", "expressive", "vibrant", "fruit-salad", "monochrome"]),
}
PROFILES = ("mac", "linux", "omarchy")
# Verrouillage et OSD restent ceux de Liquid Glass : échanger le plugin de
# verrouillage à chaud laisse deux gestionnaires IPC « lock » en concurrence.
# Le sélecteur de styles (⌘⇧Espace) est dans les deux profils.
LINUX_PLUGINS = ["liquid-glass.linux", "liquid-glass.spotify", "liquid-glass.settings", "liquid-glass.lock", "liquid-glass.osd",
                 "liquid-glass.profiles"]
PICKER_PLUGIN = "liquid-glass.profiles"
TEIGUUU_REPO = "https://github.com/Teiguuu/dotfiles"
BAR_OFF_FLAG = HOME / ".local/state/omarchy/toggles/bar-off"


def style_label(st: str) -> str:
    return {"gouts": "Mes goûts"}.get(st, st.capitalize())


def linux_style(cfg: dict | None = None) -> str:
    cfg = cfg if cfg is not None else load()
    st = str(cfg.get("linux", {}).get("style", "blanc"))
    return st if st in LINUX_STYLES else "blanc"   # « lain » (retiré) → blanc


def style_theme(cfg: dict | None = None) -> str:
    """Thème Omarchy du style Linux courant."""
    cfg = cfg if cfg is not None else load()
    st = linux_style(cfg)
    if st == "violet":
        return VIOLET_TONES.get(str(cfg.get("linux", {}).get("violet_tone", "nuit")), "violet")
    if st == "windows":
        return "windows-sombre" if str(cfg.get("linux", {}).get("windows_tone", "clair")) == "sombre" else "windows"
    if st == "gouts":    # suit un thème Omarchy d'origine
        return str(cfg.get("linux", {}).get("gouts_theme", "")) or _stock_theme()
    if st == "mono":
        t = str(cfg.get("linux", {}).get("mono_tone", "noir"))
        return "mono-" + t if t in ("papier", "sakura") else "mono"
    if st in ("blanc", "sombre", "jouet", "foret", "ruban", "espace", "cosmos", "ile", "debian", "fedora", "mint", "kali", "arch"):
        return st
    return LINUX_THEME


def _ensure_linux_theme_files(theme: str) -> None:
    """Thèmes générés : fichiers et fonds créés au premier usage."""
    if theme == LINUX_THEME:
        _ensure_linux_wallpapers()
        return
    d = REPO / "themes" / theme
    if theme not in LINUX_THEMES:    # thème Omarchy d'origine (« Mes goûts ») : rien à générer
        return
    if not (d / "colors.toml").exists():
        run(str(REPO / "scripts/gen-linux-themes.py"))
    if not any((d / "backgrounds").glob("*.jpg")):
        print("Génération des fonds (une seule fois)…")
        fam = theme.split("-")[0] if theme.startswith(("windows", "mono")) else theme
        extra = [fam] if fam in ("windows", "mono", "foret") else []
        run("nice", "-n", "10", str(REPO / "scripts/gen-linux-wallpapers.py"), str(REPO / "themes"), *extra)
    if not any((d / "backgrounds").glob("*.jpg")):    # thèmes sans fonds générés : pris sur le web
        run("nice", "-n", "10", str(REPO / "scripts/fetch-style-wallpapers.py"), theme)
    link = HOME / ".config/omarchy/themes" / theme
    if not link.exists():
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(d)


def _with_plugin(data: dict, pid: str) -> dict:
    ids = [p.get("id") for p in data.get("plugins", []) if isinstance(p, dict)]
    if pid not in ids:
        data.setdefault("plugins", []).append({"id": pid})
    return data


def current_profile(cfg: dict | None = None) -> str:
    cfg = cfg if cfg is not None else load()
    p = str(cfg.get("profile", {}).get("active", "mac"))
    return p if p in PROFILES else "mac"


def _stock_shell_json() -> dict:
    """shell.json d'Omarchy « sans aucun changement » : celui d'avant Liquid Glass
    (sauvegarde ~/.config-backup-*), sinon celui livré par Omarchy. Seul ajout :
    le sélecteur de bureaux, pour pouvoir revenir (⌘⇧Espace)."""
    saved = PROFILE_DIR / "omarchy.shell.json"
    src = None
    if saved.exists():
        src = saved
    else:
        backups = sorted(HOME.glob(".config-backup-*/files/.config/omarchy/shell.json"))
        src = backups[0] if backups else Path("/usr/share/omarchy/config/omarchy/shell.json")
    try:
        data = json.loads(src.read_text())
    except (OSError, json.JSONDecodeError):
        data = {}
    return _with_plugin(data, PICKER_PLUGIN)


def _stock_theme() -> str:
    f = PROFILE_DIR / "omarchy.theme"
    if f.exists() and f.read_text().strip():
        return f.read_text().strip()
    for b in sorted(HOME.glob(".config-backup-*/omarchy-theme.txt")):
        slug = re.sub(r"[^a-z0-9]+", "-", b.read_text().strip().lower()).strip("-")
        if (Path("/usr/share/omarchy/themes") / slug).exists() or (USER_THEMES / slug).exists():
            return slug
    return "tokyo-night"


def _write_shell_json(data: dict) -> None:
    tmp = SHELL_JSON.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(SHELL_JSON)


def _linux_shell_json(mac: dict) -> dict:
    """shell.json du profil Linux : celui déjà gardé, sinon dérivé du Mac
    (sans aucun plugin Liquid Glass sauf le bureau Linux, Spotify, Réglages,
    le verrouillage et l'OSD ; pas de Dock)."""
    saved = PROFILE_DIR / "linux.shell.json"
    if saved.exists():
        try:
            data = json.loads(saved.read_text())
        except json.JSONDecodeError:
            data = None
        if isinstance(data, dict):
            ids = [p.get("id") for p in data.get("plugins", []) if isinstance(p, dict)]
            for pid in LINUX_PLUGINS:
                if pid not in ids:
                    data.setdefault("plugins", []).append({"id": pid})
            return data
    data = json.loads(json.dumps(mac))
    data["plugins"] = [{"id": pid} for pid in LINUX_PLUGINS]
    return data


def _ensure_linux_wallpapers() -> None:
    """Fonds lain : récupérés depuis les dotfiles Teiguuu s'ils manquent
    (non versionnés dans ce dépôt)."""
    dest = REPO / "themes" / LINUX_THEME / "backgrounds"
    if any(dest.glob("*.png")) or not have("git"):
        return
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        if run("git", "clone", "--depth", "1", "--filter=blob:none", TEIGUUU_REPO, tmp).returncode != 0:
            print("fonds lain non récupérés (hors ligne ?)", file=sys.stderr)
            return
        src = Path(tmp) / "wallpaper"
        order = ["wallpaper", "4", "8", "17", "1", "2", "5", "6", "7", "9", "10", "11", "13", "14", "15", "16"]
        dest.mkdir(parents=True, exist_ok=True)
        for i, name in enumerate(order, 1):
            f = src / f"{name}.png"
            if f.exists():
                shutil.copy(f, dest / f"{i:02d}-lain.png")


def apply_fastfetch(style: str | None) -> None:
    """Fiche du `fastfetch` tapé à la main : suit le bureau actif et la langue."""
    cfg = load()
    active = cfg.get("profile", {}).get("active", "mac")
    lg_fetch.write_default(style or ("omarchy" if active == "omarchy" else "mac"), CONF_DIR.parent / "fastfetch/config.jsonc",
                           cfg.get("linux", {}).get("lang", "fr"))


def _omarchy_themes() -> list[str]:
    """Thèmes Omarchy installés, sans ceux de Liquid Glass."""
    names = set()
    for base in (Path("/usr/share/omarchy/themes"), HOME / ".config/omarchy/themes"):
        if base.is_dir():
            names |= {p.name for p in base.iterdir() if (p / "colors.toml").exists()}
    return sorted(names - set(LINUX_THEMES) - set(THEMES.values()))


def _apply_tone(st: str, tone: str) -> None:
    key, vals = ("gouts_theme", _omarchy_themes()) if st == "gouts" else STYLE_TONES[st]
    if tone not in vals:
        sys.exit(f"teinte inconnue pour {st} : {tone} ({', '.join(vals)})")
    set_key("linux." + key, tone)


def cmd_profile(args: list[str]) -> None:
    cfg = load()
    now = current_profile(cfg)
    want = args[0] if args else "status"
    if want == "status":
        st = linux_style(cfg)
        tone = ""
        if st in STYLE_TONES:
            key, vals = STYLE_TONES[st]
            tone = str(cfg.get("linux", {}).get(key, vals[0]))
        stock = _stock_theme()
        stock_bg = ""
        for d in (USER_THEMES / stock / "backgrounds", Path("/usr/share/omarchy/themes") / stock / "backgrounds"):
            imgs = sorted(x for x in d.glob("*") if x.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp")) if d.is_dir() else []
            if imgs:
                stock_bg = str(imgs[0])
                break
        print(json.dumps({"profile": now, "style": st, "tone": tone,
                          "violet_tone": str(cfg.get("linux", {}).get("violet_tone", "nuit")),
                          "theme": current_theme(), "stock_theme": stock, "stock_bg": stock_bg},
                         ensure_ascii=False))
        return
    if want == "pick":
        # Sélecteur de bureaux (⌘⇧Espace) ; repli : bascule simple.
        # (omarchy-shell répond 0 même pour un plugin absent : on vérifie shell.json.)
        try:
            loaded = PICKER_PLUGIN in [p.get("id") for p in json.loads(SHELL_JSON.read_text()).get("plugins", [])]
        except (OSError, json.JSONDecodeError):
            loaded = False
        if loaded:
            run("omarchy-shell", "shell", "toggle", PICKER_PLUGIN)
        else:
            cmd_profile(["toggle"])
        return
    if want == "tone":
        # Teinte du style courant : `tone` (suivante), `tone <nom>`.
        st = linux_style(cfg)
        if st not in STYLE_TONES:
            print(f"Le style {st} n'a qu'une teinte.")
            return
        key, vals = STYLE_TONES[st]
        cur = str(cfg.get("linux", {}).get(key, vals[0]))
        nxt = args[1] if len(args) > 1 and args[1] != "next" else vals[(vals.index(cur) + 1) % len(vals) if cur in vals else 0]
        _apply_tone(st, nxt)
        cfg = load()
        write_json(cfg)
        if now == "linux":
            theme = style_theme(cfg)
            _ensure_linux_theme_files(theme)
            if current_theme() != theme:
                set_theme(theme)
            run("omarchy-notification-send", "-u", "low", f"{style_label(st)} · {nxt}", "⌃⌘T pour la teinte suivante")
        print(f"Teinte {nxt}.")
        return
    if want == "toggle":
        want = "linux" if now == "mac" else "mac"
    # Un style, éventuellement avec sa teinte (« violet:aube »), ou un ancien nom de teinte.
    tones = {"violet-nuit": ("violet", "nuit"), "violet-aube": ("violet", "aube"), "aube": ("violet", "aube"),
             "rose": ("violet", "rose"), "nuit": ("violet", "nuit")}
    style, _, tone = want.partition(":")
    if style in tones:
        style, tone = tones[style][0], tone or tones[style][1]
    if style in LINUX_STYLES:
        if tone and (style in STYLE_TONES or style == "gouts"):
            _apply_tone(style, tone)
        set_key("linux.style", style)
        cfg = load()
        write_json(cfg)
        if now == "linux":
            apply_fastfetch(style)
            theme = style_theme(cfg)
            _ensure_linux_theme_files(theme)
            if current_theme() != theme:
                set_theme(theme)
            run("omarchy-notification-send", "-u", "low", "Bureau " + style_label(style), "⌘⇧Espace pour changer de bureau")
            print(f"Style {style}.")
            return
        want = "linux"
    if want not in PROFILES:
        sys.exit("usage : liquid-glass profile [mac|linux|omarchy|toggle|pick|status|tone [nom]|"
                 + "|".join(LINUX_STYLES) + "|<style>:<teinte>]")
    if want == now:
        print(f"Déjà sur le profil {now}.")
        return
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    if not SHELL_JSON.exists():
        sys.exit("shell.json introuvable")
    current_shell = json.loads(SHELL_JSON.read_text())

    # 1. On garde l'état du profil qu'on quitte.
    if now == "mac":
        (PROFILE_DIR / "mac.shell.json").write_text(json.dumps(_with_plugin(current_shell, PICKER_PLUGIN), indent=2, ensure_ascii=False) + "\n")
        (PROFILE_DIR / "mac.theme").write_text(current_theme() + "\n")
        (PROFILE_DIR / "mac.bar-off").write_text("1\n" if BAR_OFF_FLAG.exists() else "0\n")
    elif now == "linux":
        (PROFILE_DIR / "linux.shell.json").write_text(json.dumps(current_shell, indent=2, ensure_ascii=False) + "\n")
    else:
        (PROFILE_DIR / "omarchy.shell.json").write_text(json.dumps(current_shell, indent=2, ensure_ascii=False) + "\n")
        (PROFILE_DIR / "omarchy.theme").write_text(current_theme() + "\n")

    # 2. On entre dans le nouveau : profil d'abord (le service Spotify rend le fond
    #    et les couleurs du thème), puis plugins, barre, Hyprland et thème.
    set_key("profile.active", want)
    cfg = load()
    write_json(cfg)
    if want == "linux":
        theme = style_theme(cfg)
        _ensure_linux_theme_files(theme)
        mac_saved = PROFILE_DIR / "mac.shell.json"
        base = json.loads(mac_saved.read_text()) if now == "omarchy" and mac_saved.exists() else current_shell
        _write_shell_json(_linux_shell_json(base))
        run("omarchy-toggle-bar", "on")     # barre Omarchy masquée : chaque style a la sienne
        render_hypr_vars(cfg)
        run("hyprctl", "reload")
        time.sleep(1.2)
        set_theme(theme)
    elif want == "mac":
        saved = PROFILE_DIR / "mac.shell.json"
        if saved.exists():
            _write_shell_json(_with_plugin(json.loads(saved.read_text()), PICKER_PLUGIN))
        bar_off = (PROFILE_DIR / "mac.bar-off").read_text().strip() == "1" if (PROFILE_DIR / "mac.bar-off").exists() else False
        run("omarchy-toggle-bar", "on" if bar_off else "off")
        render_hypr_vars(cfg)
        run("hyprctl", "reload")
        theme_file = PROFILE_DIR / "mac.theme"
        theme = theme_file.read_text().strip() if theme_file.exists() else ""
        if not theme or theme in LINUX_THEMES:
            theme = THEMES[desired_mode(cfg)]
        set_theme(theme)
    else:
        # Omarchy tel quel : son shell.json, sa barre, son thème, ses raccourcis.
        _write_shell_json(_stock_shell_json())
        run("omarchy-toggle-bar", "off")
        render_hypr_vars(cfg)
        run("hyprctl", "reload")
        set_theme(_stock_theme())
    names = {"mac": "Mac", "linux": "Linux · " + style_label(linux_style(cfg)), "omarchy": "Omarchy (d'origine)"}
    apply_fastfetch(linux_style(cfg) if want == "linux" else None)
    run("omarchy-notification-send", "-u", "low", "Bureau " + names[want], "⌘⇧Espace pour changer de bureau")
    print(f"Profil {want}.")



#!/usr/bin/env python3
"""liquid-glass — pilote central du bureau Liquid Glass.

Commandes :
  liquid-glass apply                 Réapplique toute la config (thèmes, Hyprland, système)
  liquid-glass mode light|dark|toggle|auto
                                     Change le mode d'apparence (auto = selon l'heure)
  liquid-glass auto-tick             (timer) Bascule si le mode auto le demande
  liquid-glass system [thème]        Applique GTK/icônes/curseur/polices pour le thème
  liquid-glass get <section.clé>     Lit un réglage
  liquid-glass set <section.clé> <valeur>
                                     Modifie un réglage (puis applique ce qui est nécessaire)
  liquid-glass status                Résumé de l'état courant
  liquid-glass show-desktop          Écarte / remet les fenêtres du bureau courant (⌘F3)
  liquid-glass hotcorner <action>    Action d'un coin actif (mission, desktop, spotlight…)
  liquid-glass window <action> [adresse]  Menus app / Fenêtre : minimize hide hide-others show-all
                                     quit zoom fullscreen fill center left right top bottom
                                     pin float next-desktop prev-desktop settings
  liquid-glass resume-music          Relance le dernier morceau Spotify (écran verrouillé)
  liquid-glass login-item <app> on|off|toggle|status
                                     Ouvrir l'app à la connexion (~/.config/autostart)
  liquid-glass focus [off|dnd|work|personal|sleep|toggle|status]
                                     Mode de concentration (Ne pas déranger ; Sommeil
                                     ajoute la lumière nocturne)
  liquid-glass gamemode [on|off|toggle|status]
                                     Mode Jeu : sans flou, ombres ni animations
  liquid-glass bar <élément> on|off|toggle|status
                                     Éléments de la barre des menus : workspaces bluetooth
                                     sound nowplaying agents spotlight battery wifi
  liquid-glass wallpapers fetch|generate|list
                                     Collection de fonds (wallhaven.cc, SFW uniquement) et
                                     fonds générés, dans ~/.local/share/liquid-glass/wallpapers
  liquid-glass animated-wallpapers [--force]
                                     Génère les fonds d'écran animés (vidéos en boucle,
                                     ffmpeg, en local) dans les thèmes Liquid Glass
  liquid-glass profile [mac|linux|omarchy|toggle|pick|status|tone [nom]|blanc|sombre|jouet|violet[:nuit|aube|rose]|expressive|windows|mono|foret]
                                     Bureau Mac ou Linux, et style du bureau Linux
                                     (pick = sélecteur en cartes, ⌘⇧Espace)
  liquid-glass fetch [--mode M]      Fiche système à la taille du terminal (image, dots, color, text)
  liquid-glass ascii [image]         Image en caractères ; --text "Salut" --font Isometric1 pour du texte
  liquid-glass export                Réglages et applications dans state/ (./install.sh --restore)
  liquid-glass lang fr|en            Langue des bureaux et des Réglages
  liquid-glass rice [launch [n]|next|stop [n]|reset]
                                     Pages de 1 à 13 terminaux animés (menu : ⌃⌘M)
  liquid-glass keys on|off|test|status|import <pack Mechvibes>
                                     Son de clavier mécanique « creamy » sur tout le système

Fichiers :
  ~/.config/liquid-glass/config.toml   config centrale (source de vérité)
  ~/.config/liquid-glass/config.json   copie JSON lue à chaud par le shell (générée)
  ~/.config/liquid-glass/hypr-vars.lua variables lues par hypr/liquid-glass.lua (générées)
"""
from __future__ import annotations

import datetime as dt
import json
import os
import random
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

HOME = Path.home()
CONF_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "liquid-glass"
CACHE_DIR = HOME / ".cache/liquid-glass"
CONF = CONF_DIR / "config.toml"
CONF_JSON = CONF_DIR / "config.json"
HYPR_VARS = CONF_DIR / "hypr-vars.lua"
# Le dépôt est retrouvé via le lien symbolique de ce script.
REPO = Path(os.path.realpath(__file__)).parent.parent
sys.path.insert(0, str(REPO / "bin"))
import lg_art  # noqa: E402
import lg_fetch  # noqa: E402
THEMES = {"light": "liquid-glass", "dark": "liquid-glass-dark"}
USER_THEMES = HOME / ".config/omarchy/themes"
STATE_THEME = HOME / ".local/state/omarchy/current/theme.name"
GTK4_CSS = HOME / ".config/gtk-4.0/gtk.css"


# ----------------------------------------------------------------- utilitaires
def run(*cmd: str, check: bool = False, quiet: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        check=check,
        text=True,
        stdout=subprocess.PIPE if quiet else None,
        stderr=subprocess.PIPE if quiet else None,
    )


def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def load() -> dict:
    if not CONF.exists():
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copy(REPO / "config/config.toml", CONF)
    return tomllib.loads(CONF.read_text())


def write_json(cfg: dict) -> None:
    tmp = CONF_JSON.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False))
    tmp.replace(CONF_JSON)  # remplacement atomique : le shell ne lit jamais un fichier à moitié écrit


def toml_value(raw: str) -> str:
    """Formate une valeur saisie en ligne de commande pour TOML."""
    low = raw.lower()
    if low in ("true", "false", "on", "off", "yes", "no"):
        return "true" if low in ("true", "on", "yes") else "false"
    if re.fullmatch(r"-?\d+(\.\d+)?", raw):
        return raw
    if raw.startswith("[") or raw.startswith('"'):
        return raw
    return json.dumps(raw, ensure_ascii=False)


def set_key(dotted: str, raw: str) -> None:
    """Édite config.toml en place, en gardant les commentaires.

    Verrou exclusif + remplacement atomique : deux `liquid-glass set` lancés en
    même temps (shell, Réglages, widgets) ne peuvent plus lire un fichier à moitié
    écrit et l'écraser (incident du 2026-11-06 : en-tête remplacé par [lyrics]).
    """
    import fcntl
    with open(CONF.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        _set_key_locked(dotted, raw)


def _set_key_locked(dotted: str, raw: str) -> None:
    section, key = dotted.split(".", 1)
    original = CONF.read_text()
    if not original.strip():
        sys.exit("config.toml vide : modification refusée")
    lines = original.splitlines(keepends=True)
    value = toml_value(raw)
    # « off » pour une clé texte (ex. spotify.wallpaper) reste du texte.
    try:
        cur = tomllib.loads("".join(lines)).get(section, {}).get(key)
    except Exception:
        cur = None
    if isinstance(cur, str) and not raw.startswith('"'):
        value = json.dumps(raw, ensure_ascii=False)
    in_sec, sec_end, done = False, None, False
    for i, line in enumerate(lines):
        m = re.match(r"^\s*\[([^\]]+)\]", line)
        if m:
            if in_sec:
                sec_end = i
                break
            in_sec = m.group(1).strip() == section
            continue
        if in_sec:
            km = re.match(rf"^(\s*{re.escape(key)}\s*=\s*)([^#\n]*?)(\s*#.*)?(\n?)$", line)
            if km:
                lines[i] = f"{km.group(1)}{value}{km.group(3) or ''}{km.group(4)}"
                done = True
                break
    if not done:
        if in_sec or sec_end is not None:
            idx = sec_end if sec_end is not None else len(lines)
            lines.insert(idx, f"{key} = {value}\n")
        else:
            lines.append(f"\n[{section}]\n{key} = {value}\n")
    text = "".join(lines)
    tomllib.loads(text)  # valide AVANT d'écrire : un TOML cassé n'atteint jamais le disque
    tmp = CONF.with_suffix(".toml.tmp")
    tmp.write_text(text)
    os.replace(tmp, CONF)


def get_key(cfg: dict, dotted: str):
    cur = cfg
    for part in dotted.split("."):
        cur = cur[part]
    return cur


def current_theme() -> str:
    try:
        return STATE_THEME.read_text().strip()
    except OSError:
        return ""


def first_existing(base: Path, names: list[str]) -> str | None:
    for n in names:
        if (base / n).exists():
            return n
    return None


def notify(title: str, body: str = "") -> None:
    if have("notify-send"):
        run("notify-send", "-a", "Liquid Glass", title, body)


# ------------------------------------------------------------------- rendu
def render_hypr_vars(cfg: dict) -> None:
    g = cfg.get("glass", {})
    vals = {
        "blur_size": int(g.get("blur_size", 7)),
        "blur_passes": int(g.get("blur_passes", 3)),
        "rounding": int(g.get("rounding", 16)),
        "gaps_in": int(g.get("gaps_in", 5)),
        "gaps_out": int(g.get("gaps_out", 10)),
        "animations": bool(g.get("animations", True)),
        "titlebars": bool(g.get("titlebars", True)),
        "mac_windows": bool(cfg.get("windows", {}).get("floating", True)),
        # Bouton vert : "menu" (menu Plein écran / Mosaïque de Tahoe) ou "zoom".
        "green_menu": str(cfg.get("windows", {}).get("green_button", "menu")) == "menu",
    }
    # Profil actif (⌘⇧Espace) : "linux" charge liquid-glass-linux.lua à la place du réglage Mac.
    body_profile = current_profile(cfg)
    body = ["-- FICHIER GÉNÉRÉ par `liquid-glass apply` depuis config.toml. Ne pas éditer.", "return {"]
    for k, v in vals.items():
        body.append(f"  {k} = {str(v).lower() if isinstance(v, bool) else v},")
    body.append(f'  profile = "{body_profile}",')
    vals_keys = bool(cfg.get("keys", {}).get("macos_shortcuts", True))
    body.append(f"  keybindings = {str(vals_keys).lower()},")
    wa = float(g.get("window_opacity_active", 0.96))
    wi = float(g.get("window_opacity_inactive", 0.90))
    body.append(f"  window_opacity = {{ {wa:.2f}, {wi:.2f} }},")
    # Souris et trackpad ([input]) : seules les clés présentes remplacent celles d'Omarchy.
    inp = cfg.get("input", {})
    top, pad = [], []
    def lua(x):
        return str(x).lower() if isinstance(x, bool) else f"{float(x):.2f}"
    for key, opt, dest, lo, hi in (
        ("sensitivity", "sensitivity", top, -1.0, 1.0),
        ("mouse_natural_scroll", "natural_scroll", top, None, None),
        ("mouse_scroll", "scroll_factor", top, 0.1, 3.0),
        ("natural_scroll", "natural_scroll", pad, None, None),
        ("tap_to_click", "tap_to_click", pad, None, None),
        ("disable_while_typing", "disable_while_typing", pad, None, None),
        ("clickfinger", "clickfinger_behavior", pad, None, None),
        ("trackpad_scroll", "scroll_factor", pad, 0.1, 3.0),
    ):
        if key not in inp:
            continue
        x = inp[key]
        if lo is not None:
            try:
                x = max(lo, min(hi, float(x)))
            except (TypeError, ValueError):
                continue
        elif not isinstance(x, bool):
            continue
        dest.append(f"{opt} = {lua(x)}")
    if top or pad:
        parts = top + ([f"touchpad = {{ {', '.join(pad)} }}"] if pad else [])
        body.append(f"  input = {{ {', '.join(parts)} }},")
    body.append("}")
    HYPR_VARS.write_text("\n".join(body) + "\n")


SHELL_JSON = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "omarchy/shell.json"


def sync_dock(cfg: dict) -> None:
    """Recopie [dock] dans le sous-arbre « dock » de shell.json (rechargé à chaud par le shell).
    Écriture atomique ; les autres clés de shell.json ne sont pas touchées."""
    if not SHELL_JSON.exists():
        return
    d = cfg.get("dock", {})
    try:
        data = json.loads(SHELL_JSON.read_text())
    except (OSError, json.JSONDecodeError):
        print("shell.json illisible : réglages du dock non synchronisés.", file=sys.stderr)
        return
    dock = data.get("dock") if isinstance(data.get("dock"), dict) else {}
    new = dict(dock)
    new["iconSize"] = int(d.get("icon_size", 48))
    new["magnification"] = float(d.get("magnification", 1.6))
    new["autohide"] = bool(d.get("autohide", False))
    new["alwaysVisible"] = bool(d.get("always_visible", True))
    if new == dock:
        return
    data["dock"] = new
    tmp = SHELL_JSON.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(SHELL_JSON)


def render_themes(cfg: dict) -> None:
    for slug in THEMES.values():
        tdir = USER_THEMES / slug
        if tdir.exists():
            run(sys.executable, str(REPO / "scripts/render-theme.py"), str(tdir), str(CONF), check=True)


def desired_mode(cfg: dict) -> str:
    ap = cfg.get("appearance", {})
    mode = ap.get("mode", "light")
    if mode != "auto":
        return mode
    now = dt.datetime.now().time()
    light_at = dt.time.fromisoformat(ap.get("auto_light_at", "07:30"))
    dark_at = dt.time.fromisoformat(ap.get("auto_dark_at", "19:30"))
    return "light" if light_at <= now < dark_at else "dark"


# Fonds jumelés clair ↔ sombre : en changeant de mode, on garde « le même » paysage
# (Tahoe jour → Tahoe nuit…), comme les fonds dynamiques de macOS.
WALL_PAIRS = {
    "01-tahoe-day.jpg": "01-tahoe-night.jpg",
    "02-big-sur-light.jpg": "02-big-sur-dark.jpg",
    "03-monterey-light.jpg": "03-monterey-dark.jpg",
    "08-monterey-morning.jpg": "04-monterey.jpg",
    "07-big-sur.jpg": "06-big-sur-morning.jpg",
    "05-yosemite-valley.jpg": "05-el-capitan-dusk.jpg",
    "09-aurora-day.jpg": "07-aurora-night.jpg",
    "10-lagoon.jpg": "08-abyss.jpg",
    "11-dune.jpg": "09-ember.jpg",
}
BG_STATE = HOME / ".local/state/omarchy/theme-backgrounds"
BG_LINK = HOME / ".local/state/omarchy/current/background"


def _pair_background(target: str) -> None:
    """Prépare le fond du thème cible à partir du fond actuel (s'il a un jumeau)."""
    if current_theme() not in THEMES.values() or target not in THEMES.values():
        return
    name = os.path.basename(os.path.realpath(BG_LINK)) if BG_LINK.exists() else ""
    pairs = {**WALL_PAIRS, **{v: k for k, v in WALL_PAIRS.items()}}
    twin = pairs.get(name)
    if not twin:
        return
    path = HOME / ".local/state/omarchy/current/theme/backgrounds" / twin
    BG_STATE.mkdir(parents=True, exist_ok=True)
    (BG_STATE / target).write_text(f"{path}\n")


def set_theme(slug: str) -> None:
    # Réappliquer le même thème (liquid-glass apply) ne doit pas changer le fond :
    # `omarchy theme set` recrée le dossier du thème courant et peut retomber sur
    # un autre fond. On note celui en place et on le remet ensuite.
    same = current_theme() == slug
    keep = os.path.basename(os.path.realpath(BG_LINK)) if same and BG_LINK.exists() else ""
    _pair_background(slug)
    run("omarchy", "theme", "set", slug, quiet=False)
    if keep:
        path = HOME / ".local/state/omarchy/current/theme/backgrounds" / keep
        now = os.path.basename(os.path.realpath(BG_LINK)) if BG_LINK.exists() else ""
        if path.exists() and now != keep:
            run("omarchy-theme-bg-set", str(path))


# --------------------------------------------------------- réglages système
def apply_system(theme: str | None = None) -> None:
    """GTK, icônes, curseur, polices selon le thème Liquid Glass actif."""
    theme = theme or current_theme()
    cfg = load()
    ours = theme in THEMES.values()
    dark = theme == THEMES["dark"]
    themes_dir, icons_dir = Path("/usr/share/themes"), Path("/usr/share/icons")

    if not ours:
        # Thème Omarchy classique : on retire notre surcouche GTK4, Omarchy gère le reste.
        _gtk4_block(None)
        return

    gs = ["gsettings", "set", "org.gnome.desktop.interface"]

    gtk = first_existing(themes_dir, ["MacTahoe-Dark-solid", "MacTahoe-Dark"] if dark else ["MacTahoe-Light-solid", "MacTahoe-Light"])
    if gtk:
        run(*gs, "gtk-theme", gtk)
        _gtk4_block(themes_dir / gtk / "gtk-4.0" / ("gtk-dark.css" if dark else "gtk.css"))
    icons = first_existing(icons_dir, ["MacTahoe-dark", "MacTahoe"] if dark else ["MacTahoe-light", "MacTahoe"])
    if icons:
        run(*gs, "icon-theme", icons)
    cursor = first_existing(icons_dir, ["MacTahoe-dark-cursors", "MacTahoe-cursors"] if dark else ["MacTahoe-cursors"])
    if cursor:
        run(*gs, "cursor-theme", cursor)
        run(*gs, "cursor-size", "24")
        if have("hyprctl"):
            run("hyprctl", "setcursor", cursor, "24")

    font = cfg.get("appearance", {}).get("font_ui", "Inter")
    if run("fc-list", f":family={font}").stdout.strip():
        run(*gs, "font-name", f"{font} 11")
        run(*gs, "document-font-name", f"{font} 11")
    run(*gs, "color-scheme", "prefer-dark" if dark else "prefer-light")


def _gtk4_block(css: Path | None) -> None:
    """Ajoute/retire l'import du thème GTK4 (libadwaita) dans ~/.config/gtk-4.0/gtk.css.

    Le bloc est délimité par des marqueurs et placé AVANT le bloc omarchy-glass,
    pour que le flou Omarchy reste prioritaire.
    """
    begin, end = "/* liquid-glass begin */", "/* liquid-glass end */"
    text = GTK4_CSS.read_text() if GTK4_CSS.exists() else ""
    text = re.sub(re.escape(begin) + r".*?" + re.escape(end) + r"\n?", "", text, flags=re.S)
    if css and css.exists():
        text = f'{begin}\n@import url("file://{css}");\n{end}\n' + text
    GTK4_CSS.parent.mkdir(parents=True, exist_ok=True)
    GTK4_CSS.write_text(text)


# ---------------------------------------------------------------- commandes
def cmd_apply(_args: list[str]) -> None:
    cfg = load()
    write_json(cfg)
    render_hypr_vars(cfg)
    render_themes(cfg)
    sync_dock(cfg)
    prof = current_profile(cfg)
    want = style_theme(cfg) if prof == "linux" else (current_theme() if prof == "omarchy" else THEMES[desired_mode(cfg)])
    # Réappliquer le thème recopie les fichiers rendus dans le thème courant.
    if prof != "omarchy":
        set_theme(want)
    run("hyprctl", "reload")
    errors = run("hyprctl", "configerrors").stdout.strip()
    if errors:
        print("Erreurs Hyprland :\n" + errors, file=sys.stderr)
    print(f"Liquid Glass appliqué ({want}).")


def cmd_mode(args: list[str]) -> None:
    if not args or args[0] not in ("light", "dark", "toggle", "auto"):
        sys.exit("usage : liquid-glass mode light|dark|toggle|auto")
    cfg = load()
    mode = args[0]
    if mode == "toggle":
        mode = "light" if current_theme() == THEMES["dark"] else "dark"
    set_key("appearance.mode", mode)
    cfg = load()
    write_json(cfg)
    if current_profile(cfg) != "mac":
        print(f"Mode : {mode} (appliqué au retour sur le bureau Mac)")
        return
    want = THEMES[desired_mode(cfg)]
    if current_theme() != want:
        set_theme(want)
    print(f"Mode : {mode} → {want}")


def cmd_auto_tick(_args: list[str]) -> None:
    cfg = load()
    if cfg.get("appearance", {}).get("mode") != "auto" or current_profile(cfg) != "mac":
        return
    want = THEMES[desired_mode(cfg)]
    if current_theme() != want:
        set_theme(want)


# Réglages qui ne demandent qu'un rechargement à chaud (le shell relit config.json).
LIVE_SECTIONS = {"linux", "spotify", "lyrics", "visualizer", "dock", "widgets", "hotcorners", "lock", "control", "island", "corners", "menubar", "shortcuts"}
# Clés isolées lues directement par le shell (pas de régénération du thème).
LIVE_KEYS = {"appearance.logo", "appearance.logo_path"}


def cmd_set(args: list[str]) -> None:
    if len(args) < 2 or len(args) % 2 or any("." not in k for k in args[0::2]):
        sys.exit("usage : liquid-glass set <section.clé> <valeur> [<section.clé> <valeur>…]")
    load()
    pairs = list(zip(args[0::2], args[1::2]))
    for k, v in pairs:
        set_key(k, v)
    cfg = load()
    write_json(cfg)
    # Plusieurs paires : uniquement des clés « à chaud » (pas d'effet de bord à rejouer).
    if len(pairs) > 1:
        return
    section = args[0].split(".", 1)[0]
    if args[0] in LIVE_KEYS:
        pass
    elif section == "appearance" and args[0].endswith(".mode"):
        cmd_mode([args[1]])
    elif section == "dock":
        sync_dock(cfg)  # shell.json est rechargé à chaud par le shell
    elif section in LIVE_SECTIONS:
        pass  # config.json est relu à chaud par le service Spotify
    elif section == "keys":
        render_hypr_vars(cfg)
        run("hyprctl", "reload")
    elif section in ("input", "windows"):
        render_hypr_vars(cfg)
        run("hyprctl", "reload")
    elif section == "glass" and args[0].split(".", 1)[1] in ("titlebars", "blur_size", "blur_passes", "rounding", "gaps_in", "gaps_out", "animations", "window_opacity_active", "window_opacity_inactive"):
        render_hypr_vars(cfg)
        run("hyprctl", "reload")
    else:
        cmd_apply([])


def cmd_get(args: list[str]) -> None:
    if len(args) != 1:
        sys.exit("usage : liquid-glass get <section.clé>")
    try:
        v = get_key(load(), args[0])
    except (KeyError, TypeError):
        sys.exit(f"{args[0]} : clé absente de config.toml")
    print(json.dumps(v, ensure_ascii=False) if not isinstance(v, str) else v)


def cmd_status(_args: list[str]) -> None:
    cfg = load()
    print(f"Thème Omarchy : {current_theme()}")
    print(f"Mode demandé  : {cfg['appearance']['mode']} (→ {desired_mode(cfg)})")
    print(f"Config        : {CONF}")


# --------------------------------------------------------- afficher le bureau
# Comme ⌘F3 sur macOS : les fenêtres du bureau courant s'écartent (rangées dans un
# bureau spécial caché), un second appel les remet à leur place.
DESK_STATE = HOME / ".cache/liquid-glass/show-desktop.json"
ADDR_RE = re.compile(r"^0x[0-9a-fA-F]+$")


def _hypr_json(what: str):
    return json.loads(run("hyprctl", "-j", what).stdout or "null")


def _move(addr: str, workspace: str) -> None:
    # Adresses et noms validés avant d'entrer dans l'expression Lua.
    if not ADDR_RE.match(addr) or not re.match(r"^(special:lgdesk|-?\d+)$", workspace):
        return
    run("hyprctl", "dispatch",
        f'hl.dsp.window.move({{ workspace = "{workspace}", follow = false, window = "address:{addr}" }})')


def cmd_show_desktop(_args: list[str]) -> None:
    DESK_STATE.parent.mkdir(parents=True, exist_ok=True)
    state = json.loads(DESK_STATE.read_text()) if DESK_STATE.exists() else None
    clients = _hypr_json("clients") or []
    hidden = {c["address"] for c in clients if c.get("workspace", {}).get("name") == "special:lgdesk"}
    if state and hidden:
        for addr, ws in state.get("windows", {}).items():
            if addr in hidden:
                _move(addr, str(ws))
        DESK_STATE.unlink(missing_ok=True)
        return
    active = (_hypr_json("activeworkspace") or {}).get("id")
    moved = {}
    for c in clients:
        if c.get("workspace", {}).get("id") == active and ADDR_RE.match(c.get("address", "")):
            moved[c["address"]] = active
            _move(c["address"], "special:lgdesk")
    DESK_STATE.write_text(json.dumps({"workspace": active, "windows": moved}))


# --------------------------------------------------------------- coins actifs
HOT_ACTIONS = {
    "mission": ["omarchy-shell", "shell", "summon", "liquid-glass.mission", ""],
    "desktop": [sys.argv[0], "show-desktop"],
    "spotlight": ["omarchy-shell", "shell", "summon", "liquid-glass.spotlight", ""],
    "control": ["omarchy-shell", "liquid-glass.control", "toggle"],
    "karaoke": ["omarchy-shell", "liquid-glass.spotify", "karaoke"],
    "lock": ["omarchy-system-lock"],
    "settings": ["omarchy-shell", "liquid-glass.settings", "toggle"],
}


def cmd_hotcorner(args: list[str]) -> None:
    """Action d'un coin actif — ignorée si la fenêtre active est en plein écran."""
    if not args or args[0] not in HOT_ACTIONS:
        sys.exit("usage : liquid-glass hotcorner " + "|".join(HOT_ACTIONS))
    win = _hypr_json("activewindow") or {}
    if win.get("fullscreen", 0):
        return
    subprocess.Popen(HOT_ACTIONS[args[0]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_system(args: list[str]) -> None:
    apply_system(args[0] if args else None)


# ------------------------------------------------------------- concentration
FOCUS_STATE = HOME / ".cache/liquid-glass/focus"
FOCUS_MODES = {"dnd": "Ne pas déranger", "work": "Travail", "personal": "Personnel", "sleep": "Sommeil"}


def _nightlight_on() -> bool:
    try:
        return json.loads(run("omarchy-shell", "nightlight", "status").stdout or "{}").get("enabled") is True
    except json.JSONDecodeError:
        return False


def cmd_focus(args: list[str]) -> None:
    """Concentration façon macOS : chaque mode coupe les notifications ;
    « Sommeil » allume aussi la lumière nocturne (et l'éteint en sortant)."""
    prev = FOCUS_STATE.read_text().strip() if FOCUS_STATE.exists() else "off"
    # Ne pas déranger a pu être coupé ailleurs (centre de notifications) : on resynchronise.
    if prev != "off" and run("omarchy-shell", "notifications", "isDnd").stdout.strip() == "off":
        prev = "off"
    mode = args[0] if args else "status"
    if mode == "status":
        print(json.dumps({"mode": prev, "label": FOCUS_MODES.get(prev, "")}, ensure_ascii=False))
        return
    if mode == "toggle":
        mode = "off" if prev != "off" else "dnd"
    if mode != "off" and mode not in FOCUS_MODES:
        sys.exit(f"mode inconnu : {mode} (off, {', '.join(FOCUS_MODES)})")
    run("omarchy-shell", "notifications", "setDnd", "off" if mode == "off" else "on")
    if mode == "sleep" and not _nightlight_on():
        run("omarchy-shell", "nightlight", "toggle")
    elif prev == "sleep" and mode != "sleep" and _nightlight_on():
        run("omarchy-shell", "nightlight", "toggle")
    FOCUS_STATE.parent.mkdir(parents=True, exist_ok=True)
    FOCUS_STATE.write_text(mode + "\n")
    print(json.dumps({"mode": mode, "label": FOCUS_MODES.get(mode, "")}, ensure_ascii=False))


# ------------------------------------------------- mode Jeu
GAME_STATE = HOME / ".cache/liquid-glass/gamemode"


def _gamemode_on() -> bool:
    """Actif seulement si l'état le dit ET que les animations sont bien coupées
    (un rechargement de Hyprland les remet : le mode est alors de fait terminé)."""
    if not GAME_STATE.exists():
        return False
    opt = run("hyprctl", "getoption", "animations:enabled").stdout
    return "bool: false" in opt


def cmd_gamemode(args: list[str]) -> None:
    """Mode Jeu façon macOS : coupe flou, ombres et animations de Hyprland et passe
    le profil d'énergie en « performance » ; « off » recharge Hyprland et remet le profil."""
    act = args[0] if args else "status"
    on = _gamemode_on()
    if act == "toggle":
        act = "off" if on else "on"
    if act == "status":
        print(json.dumps({"enabled": on}))
        return
    if act == "on":
        prev = run("powerprofilesctl", "get").stdout.strip() if shutil.which("powerprofilesctl") else ""
        run("hyprctl", "eval", "hl.config({ animations = { enabled = false }, decoration = "
            "{ blur = { enabled = false }, shadow = { enabled = false } } })")
        if prev and prev != "performance":
            run("powerprofilesctl", "set", "performance")
        GAME_STATE.parent.mkdir(parents=True, exist_ok=True)
        GAME_STATE.write_text((prev or "") + "\n")
    elif act == "off":
        prev = GAME_STATE.read_text().strip() if GAME_STATE.exists() else ""
        GAME_STATE.unlink(missing_ok=True)
        run("hyprctl", "reload")
        if prev and shutil.which("powerprofilesctl"):
            run("powerprofilesctl", "set", prev)
    else:
        sys.exit("usage : liquid-glass gamemode on|off|toggle|status")
    print(json.dumps({"enabled": act == "on"}))


# ------------------------------------------------- menus « app » et « Fenêtre »
MINI_WS = "special:minimized"   # même bureau spécial que le Dock (DockModel.js)
WINDOW_ACTIONS = ("minimize", "hide", "hide-others", "show-all", "quit", "force-quit", "zoom",
                  "fullscreen", "fill", "center", "left", "right", "top", "bottom",
                  "top-left", "top-right", "bottom-left", "bottom-right", "pin", "float",
                  "next-desktop", "prev-desktop", "settings")


def _dsp(expr: str) -> None:
    run("hyprctl", "dispatch", expr)


def _target(addr: str) -> str:
    return f'window = "address:{addr}"'


def _workarea() -> tuple[int, int, int, int]:
    """Zone utile du moniteur actif en coordonnées logiques (barre, Dock, marges)."""
    mons = _hypr_json("monitors") or []
    mon = next((m for m in mons if m.get("focused")), mons[0] if mons else None)
    if not mon:
        return 0, 0, 1280, 720
    k = float(mon.get("scale") or 1)
    w, h = round(mon["width"] / k), round(mon["height"] / k)
    left, top, right, bottom = (mon.get("reserved") or [0, 0, 0, 0])[:4]
    gap = 10
    dock = 0
    try:
        cfg = load()
        if cfg.get("dock", {}).get("always_visible", True) and not cfg.get("dock", {}).get("autohide", False):
            dock = int(cfg.get("dock", {}).get("icon_size", 42)) + 26
    except Exception:
        dock = 68
    x = mon["x"] + left + gap
    y = mon["y"] + top + gap
    # Le Dock réserve déjà sa place quand il est toujours visible (reserved[3]).
    return x, y, w - left - right - 2 * gap, h - top - bottom - 2 * gap - (0 if bottom else dock)


def _place(addr: str, x: int, y: int, w: int, h: int) -> None:
    t = _target(addr)
    _dsp(f'hl.dsp.window.float({{ action = "on", {t} }})')
    _dsp(f'hl.dsp.window.resize({{ x = {int(w)}, y = {int(h)}, {t} }})')
    _dsp(f'hl.dsp.window.move({{ x = {int(x)}, y = {int(y)}, {t} }})')


def cmd_window(args: list[str]) -> None:
    """Actions des menus macOS de la barre (app et Fenêtre). Adresses validées."""
    if not args or args[0] not in WINDOW_ACTIONS:
        sys.exit("usage : liquid-glass window " + "|".join(WINDOW_ACTIONS))
    act = args[0]
    clients = _hypr_json("clients") or []
    win = _hypr_json("activewindow") or {}
    # Fenêtre visée par son adresse (boutons des barres de titre), sinon la fenêtre active.
    if len(args) > 1:
        want = args[1] if args[1].startswith("0x") else "0x" + args[1]
        win = next((c for c in clients if c.get("address") == want), None) or {}
    addr = win.get("address", "")
    cls = win.get("class", "")
    ws = (_hypr_json("activeworkspace") or {}).get("id")

    if act == "show-all":
        if isinstance(ws, int) and ws >= 1:
            for c in clients:
                if c.get("workspace", {}).get("name") == MINI_WS and ADDR_RE.match(c.get("address", "")):
                    _dsp(f'hl.dsp.window.move({{ workspace = "{ws}", follow = false, {_target(c["address"])} }})')
        return
    if not ADDR_RE.match(addr):
        return
    t = _target(addr)
    same_app = [c["address"] for c in clients if c.get("class") == cls and ADDR_RE.match(c.get("address", ""))]

    if act == "minimize":
        _dsp(f'hl.dsp.window.move({{ workspace = "{MINI_WS}", follow = false, {t} }})')
    elif act == "hide":
        for a in same_app:
            _dsp(f'hl.dsp.window.move({{ workspace = "{MINI_WS}", follow = false, {_target(a)} }})')
    elif act == "hide-others":
        for c in clients:
            if (c.get("workspace", {}).get("id") == ws and c.get("class") != cls
                    and ADDR_RE.match(c.get("address", ""))):
                _dsp(f'hl.dsp.window.move({{ workspace = "{MINI_WS}", follow = false, {_target(c["address"])} }})')
    elif act == "quit":
        for a in same_app:
            _dsp(f'hl.dsp.window.close({{ {_target(a)} }})')
    elif act == "force-quit":
        # ⌥ + Quitter (Dock) : SIGKILL sur chaque processus de l'app.
        pids = {c.get("pid") for c in clients if c.get("class") == cls}
        for pid in pids:
            if isinstance(pid, int) and pid > 1:
                try:
                    os.kill(pid, 9)
                except OSError:
                    pass
    elif act == "zoom":
        _dsp(f'hl.dsp.window.fullscreen({{ mode = "maximized", action = "toggle", {t} }})')
    elif act == "fullscreen":
        _dsp(f'hl.dsp.window.fullscreen({{ mode = "fullscreen", action = "toggle", {t} }})')
    elif act == "float":
        _dsp(f'hl.dsp.window.float({{ action = "toggle", {t} }})')
    elif act == "pin":
        if not win.get("floating"):
            _dsp(f'hl.dsp.window.float({{ action = "on", {t} }})')
        _dsp(f'hl.dsp.window.pin({{ action = "toggle", {t} }})')
    elif act == "center":
        _dsp(f'hl.dsp.window.float({{ action = "on", {t} }})')
        _dsp(f'hl.dsp.window.center({{ {t} }})')
    elif act in ("fill", "left", "right", "top", "bottom",
                 "top-left", "top-right", "bottom-left", "bottom-right"):
        x, y, w, h = _workarea()
        half_w, half_h, g = (w - 10) // 2, (h - 10) // 2, 10
        box = {
            "fill": (x, y, w, h),
            "left": (x, y, half_w, h),
            "right": (x + half_w + g, y, half_w, h),
            "top": (x, y, w, half_h),
            "bottom": (x, y + half_h + g, w, half_h),
            "top-left": (x, y, half_w, half_h),
            "top-right": (x + half_w + g, y, half_w, half_h),
            "bottom-left": (x, y + half_h + g, half_w, half_h),
            "bottom-right": (x + half_w + g, y + half_h + g, half_w, half_h),
        }[act]
        _place(addr, *box)
    elif act in ("next-desktop", "prev-desktop"):
        if isinstance(ws, int) and ws >= 1:
            dest = ws + 1 if act == "next-desktop" else max(1, ws - 1)
            _dsp(f'hl.dsp.window.move({{ workspace = "{dest}", follow = true, {t} }})')
    elif act == "settings":
        # Réglages de l'app (⌘, sur Mac) : la plupart des apps Linux utilisent Ctrl+,.
        run("wtype", "-M", "ctrl", ",", "-m", "ctrl")


# Menus Fichier / Édition / Présentation : raccourci envoyé à l'app active.
# [modificateurs, touche] pour les apps, puis pour les terminaux (None = rien :
# Ctrl+Z suspendrait le programme du terminal, Ctrl+C l'interromprait).
KEY_ACTIONS = {
    "new": (["ctrl"], "n", ["ctrl", "shift"], "n"),
    "open": (["ctrl"], "o", None, None),
    "save": (["ctrl"], "s", None, None),
    "saveas": (["ctrl", "shift"], "s", None, None),
    "print": (["ctrl"], "p", None, None),
    "undo": (["ctrl"], "z", None, None),
    "redo": (["ctrl", "shift"], "z", None, None),
    "cut": (["ctrl"], "x", None, None),
    "copy": (["ctrl"], "c", ["ctrl", "shift"], "c"),
    "paste": (["ctrl"], "v", ["ctrl", "shift"], "v"),
    "selectall": (["ctrl"], "a", None, None),
    "find": (["ctrl"], "f", None, None),
    "zoomin": (["ctrl"], "plus", ["ctrl"], "plus"),
    "zoomout": (["ctrl"], "minus", ["ctrl"], "minus"),
    "zoomreset": (["ctrl"], "0", ["ctrl"], "0"),
}
TERMINAL_RE = re.compile(r"(foot|alacritty|kitty|ghostty|wezterm|konsole|terminal|org\.omarchy\.agent)", re.I)


def cmd_key(args: list[str]) -> None:
    if not args or args[0] not in KEY_ACTIONS:
        sys.exit("usage : liquid-glass key " + "|".join(KEY_ACTIONS))
    # Laisse le menu se fermer et le focus revenir à l'app avant d'envoyer la touche.
    import time
    time.sleep(0.15)
    cls = (_hypr_json("activewindow") or {}).get("class", "")
    mods, key, tmods, tkey = KEY_ACTIONS[args[0]]
    if TERMINAL_RE.search(cls or ""):
        mods, key = tmods, tkey
    if not key:
        return
    cmd = ["wtype"]
    for m in mods:
        cmd += ["-M", m]
    cmd += ["-k", key]
    for m in reversed(mods):
        cmd += ["-m", m]
    run(*cmd)


# Éléments optionnels de la barre des menus (shell.json, rechargé à chaud).
# clé : (id du module, côté, placement) ; placement = id avant lequel l'insérer.
BAR_ITEMS = {
    "workspaces": ("omarchy.workspaces", "left", None),
    "bluetooth": ("omarchy.bluetooth", "right", "liquid-glass.power"),
    "sound": ("omarchy.audio", "right", "liquid-glass.power"),
    "nowplaying": ("liquid-glass.spotify", "right", "FIRST"),
    "agents": ("omarchy.agents", "right", "liquid-glass.power"),
    "battery": ("liquid-glass.power", "right", "omarchy.network"),
    "wifi": ("omarchy.network", "right", "liquid-glass.search"),
    "spotlight": ("liquid-glass.search", "right", "liquid-glass.control"),
    "shortcuts": ("liquid-glass.shortcuts", "right", "omarchy.indicators"),
}


def cmd_bar(args: list[str]) -> None:
    sj = Path.home() / ".config/omarchy/shell.json"
    data = json.loads(sj.read_text())
    layout = data.setdefault("bar", {}).setdefault("layout", {})
    if not args or args[0] == "status":
        present = {m.get("id") for side in ("left", "right", "center") for m in layout.get(side, []) if isinstance(m, dict)}
        res = {k: v[0] in present for k, v in BAR_ITEMS.items()}
        res["background"] = data.get("bar", {}).get("background", "opaque")
        res["battery_percent"] = any(isinstance(m, dict) and m.get("id") == "liquid-glass.power" and m.get("showPercentage")
                                     for m in layout.get("right", []))
        print(json.dumps(res))
        return
    if args[0] == "background":
        # Transparente (Tahoe) | verre | opaque ; le texte s'adapte au fond quand elle est transparente.
        if len(args) < 2 or args[1] not in ("none", "glassy", "opaque"):
            sys.exit("usage : liquid-glass bar background none|glassy|opaque")
        run("omarchy-bar", "background", args[1])
        cmd_bar_contrast([])
        return
    if args[0] not in BAR_ITEMS or len(args) < 2 or args[1] not in ("on", "off", "toggle"):
        sys.exit("usage : liquid-glass bar <" + "|".join(BAR_ITEMS) + "> on|off|toggle")
    mid, side, before = BAR_ITEMS[args[0]]
    items = layout.setdefault(side, [])
    has = any(isinstance(m, dict) and m.get("id") == mid for m in items)
    want = (not has) if args[1] == "toggle" else args[1] == "on"
    items = [m for m in items if not (isinstance(m, dict) and m.get("id") == mid)]
    if want:
        idx = len(items)
        if before == "FIRST":
            idx = 0
        elif before:
            idx = next((i for i, m in enumerate(items) if isinstance(m, dict) and m.get("id") == before), len(items))
        items.insert(idx, {"id": mid})
    layout[side] = items
    tmp = sj.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(sj)



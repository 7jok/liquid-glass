def rice_grid(n: int) -> list[list[float]]:
    """Cases (x, y, l, h) en fractions d'écran. La première est la grande quand il y en a une :
    13 = grille 4×4 dont le centre fait 2×2, 7 = 4×2 avec une double, etc."""
    plan = {1: (1, 1, None), 2: (2, 1, None), 3: (2, 2, (0, 0, 1, 2)), 4: (2, 2, None), 5: (3, 2, (0, 0, 2, 1)),
            6: (3, 2, None), 7: (4, 2, (1, 0, 2, 1)), 8: (4, 2, None), 9: (3, 3, None), 10: (4, 3, (0, 0, 3, 1)),
            11: (4, 3, (1, 1, 2, 1)), 12: (4, 3, None), 13: (4, 4, (1, 1, 2, 2))}
    cols, rows, big = plan[max(1, min(13, n))]
    cells = [[big[0] / cols, big[1] / rows, big[2] / cols, big[3] / rows]] if big else []
    for y in range(rows):
        for x in range(cols):
            if not (big and big[0] <= x < big[0] + big[2] and big[1] <= y < big[1] + big[3]):
                cells.append([x / cols, y / rows, 1 / cols, 1 / rows])
    return cells


def _rice_defaults(style: str) -> dict:
    font, alpha, gap, scenes = RICE_STYLES.get(style, RICE_STYLES["gouts"])
    sc = scenes.split()
    return {"page": 0, "font": font, "alpha": alpha, "gap": gap, "size": 0, "minutes": 25, "video": "", "pages": [
        {"name": "Duo", "panes": sc[:2], "cycle": 0},
        {"name": "Mosaïque", "panes": sc[:5], "cycle": 60},
        {"name": "Mur", "panes": sc[:13], "cycle": 120},
    ]}


def _rice_all() -> dict:
    try:
        return json.loads(RICE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def rice_state(style: str | None = None) -> dict:
    style = style or linux_style()
    d = _rice_defaults(style)
    saved = _rice_all().get(style)
    if isinstance(saved, dict):
        d.update({k: v for k, v in saved.items() if k in d})
    ok = set(RICE_SCENES) | set(RICE_SPECIAL)
    pages = []
    for p in d["pages"] if isinstance(d["pages"], list) else []:
        panes = [x for x in p.get("panes", []) if x in ok][:13]
        if panes:
            pages.append({"name": str(p.get("name", "Page")), "panes": panes, "cycle": int(p.get("cycle", 0))})
    d["pages"] = pages or _rice_defaults(style)["pages"]
    d["page"] = max(0, min(len(d["pages"]) - 1, int(d["page"])))
    return d


def rice_save(style: str, state: dict) -> None:
    allp = _rice_all()
    allp[style] = {k: state[k] for k in ("page", "font", "alpha", "gap", "size", "minutes", "pages", "video") if k in state}
    tmp = RICE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(allp, ensure_ascii=False, indent=1))
    tmp.replace(RICE_FILE)


def _rice_clients(page: int | None = None) -> list[dict]:
    pre = "liquid-glass-rice-" + ("" if page is None else f"{page}-")
    try:
        return [c for c in json.loads(run("hyprctl", "clients", "-j").stdout or "[]") if str(c.get("class", "")).startswith(pre)]
    except json.JSONDecodeError:
        return []


def rice_stop(page: int | None = None) -> None:
    pat = "--app-id liquid-glass-rice-" + ("" if page is None else f"{page}-")
    subprocess.run(["pkill", "-f", "--", pat], check=False)


def _lua_str(s: str) -> str:
    """Chaîne longue Lua dont le délimiteur n'apparaît pas dans le texte : un titre ou un chemin
    contenant ]==] ne peut pas fermer la chaîne et injecter du Lua dans Hyprland."""
    n = 2
    while f"]{'=' * n}]" in s:
        n += 1
    return f"[{'=' * n}[" + s + f"]{'=' * n}]"


def rice_random(ws: int | None = None, silent: bool = False, monitor: str = "", count: int = 0) -> None:
    """⌃⌘M : un rice tiré au sort, de 1 à 13 terminaux, sans menu. Relancé, il retire au sort
    sur le même bureau."""
    style = linux_style()
    open_now = _rice_clients()
    if ws is None and open_now:
        ws = open_now[0]["workspace"]["id"]
        silent = True
    rice_stop()
    last = rice_last()
    n = count or random.choice([x for x in range(1, 14) if x != last])
    pool = [x for x in RICE_STYLES.get(style, RICE_STYLES["gouts"])[3].split() if x not in ("timer", "shell", "cover", "video")]
    pool = list(dict.fromkeys(pool + RICE_NEW))
    random.shuffle(pool)
    heavy = 0
    panes: list[str] = []
    hero = random.choice(RICE_HERO)
    if not count and random.random() < 0.2:      # terminal, moniteur et pluie de code, comme les rices classiques
        n, panes = 3, ["btop", "fetch", "rain"]
    else:
        panes.append(hero)
        if n >= 2 and hero != "fetch":
            panes.append("fetch")
        for x in pool:
            if len(panes) >= n:
                break
            if x in panes:
                continue
            if x in ("asciivid", "clip"):
                if heavy >= 2:
                    continue
                heavy += 1
            panes.append(x)
        while len(panes) < n:
            panes.append(random.choice(["ascii", "banner", "fetch", "rain", "stars", "plasma", "pipes"]))
    st_alpha = RICE_STYLES.get(style, RICE_STYLES["gouts"])[1]
    rice_remember(n)
    if not count and random.random() < 0.12:
        panes, pal, alpha = RICE_SIGNED[random.choice(list(RICE_SIGNED))]
        rice_remember(len(panes))
        rice_launch(RICE_RANDOM_PAGE, ws, silent, monitor, panes=list(panes), alpha=alpha, pal=pal)
        return
    pal = random.choice(list(RICE_PALETTES)) if random.random() < 0.45 else ""
    rice_launch(RICE_RANDOM_PAGE, ws, silent, monitor, panes=panes, alpha=random.choice([st_alpha, 0.72, 0.55]), pal=pal)


def rice_last() -> int:
    try:
        return int((Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "liquid-glass-rice-last").read_text())
    except (OSError, ValueError):
        return 0


def rice_remember(n: int) -> None:
    (Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "liquid-glass-rice-last").write_text(str(n))


def rice_launch(page: int | None = None, ws: int | None = None, silent: bool = False, monitor: str = "",
                panes: list[str] | None = None, alpha: float | None = None, pal: str = "") -> None:
    style = linux_style()
    st = rice_state(style)
    if panes is None:
        page = st["page"] if page is None else page % len(st["pages"])
        pg = st["pages"][page]
    else:
        pg = {"panes": panes, "cycle": 0}
    if panes is None and ws is None and (open_now := _rice_clients(page)):      # déjà ouverte : on y va
        run("hyprctl", "dispatch", f'hl.dsp.focus({{ workspace = "{open_now[0]["workspace"]["id"]}" }})')
        return
    rice_stop(page)
    if panes is None:
        st["page"] = page
        rice_save(style, st)
    try:
        mons = json.loads(run("hyprctl", "monitors", "-j").stdout or "[]")
        used = {w.get("id") for w in json.loads(run("hyprctl", "workspaces", "-j").stdout or "[]")}
    except json.JSONDecodeError:
        mons, used = [], set()
    m = next((x for x in mons if x["name"] == monitor), None) or next((x for x in mons if x.get("focused")), mons[0] if mons else None)
    if not m:
        sys.exit("aucun écran")
    if ws is None:
        ws = next((i for i in range(1, 10) if i not in used), 9)
    sc = float(m.get("scale", 1)) or 1
    W, H = m["width"] / sc, m["height"] / sc
    rl, rt, rr, rb = (m.get("reserved") or [0, 0, 0, 0])[:4]
    gap = int(st["gap"])
    ax, ay = rl + gap, rt + gap
    aw, ah = W - rl - rr - 2 * gap, H - rt - rb - 2 * gap
    panes = pg["panes"]
    n = len(panes)
    font = st["font"]
    size = int(st["size"]) or (14 if n <= 2 else 11 if n <= 5 else 9 if n <= 9 else 8)
    size = max(5, round(size * RICE_FONT_SCALE.get(font, 1)))
    fps = 24 if n <= 2 else 20 if n <= 5 else 12 if n <= 9 else 8
    tty = str(REPO / "bin/liquid-glass-tty")
    alpha = st["alpha"] if alpha is None else alpha
    bus = os.environ.get("XDG_RUNTIME_DIR", "/tmp") + f"/liquid-glass-rice-audio-{page}"
    loop = ",".join(x for x in RICE_STYLES.get(style, RICE_STYLES["gouts"])[3].split() if x in RICE_SCENES and x not in ("timer", "cover", "video"))
    label = style_label(style)
    glyph = RICE_GLYPHS.get(style, "")
    master_done = False
    if not silent:
        run("hyprctl", "dispatch", f'hl.dsp.focus({{ workspace = "{ws}" }})')
    for i, (scene, cell) in enumerate(zip(panes, rice_grid(n))):
        x = ax + cell[0] * (aw + gap)
        y = ay + cell[1] * (ah + gap)
        w = cell[2] * (aw + gap) - gap
        h = cell[3] * (ah + gap) - gap
        if scene == "btop" and (w < 460 or h < 280):     # btop refuse de s'afficher en dessous de 80×24
            scene = "rain"
        scene, _, fetch_mode = scene.partition(":")      # fetch:image, fetch:text…
        if scene == "fetch":
            argv = [str(REPO / "bin/liquid-glass-fetch"), "--style", style, "--shell"]
            argv += ["--mode", fetch_mode] if fetch_mode else []
        elif scene == "clip":
            clips = lg_art.loops()
            argv = (["mpv", "--vo=tct", "--no-audio", "--loop-file=inf", "--really-quiet", "--no-input-terminal",
                     str(random.choice(clips))] if clips else ["btop"])
        elif scene == "shell":
            argv = ["sh", "-c", "exec \"${SHELL:-bash}\""]
        elif scene == "btop":
            argv = ["btop"]
        else:
            argv = [tty, scene, "--fps", str(fps), "--minutes", str(st["minutes"]), "--label", label, "--glyph", glyph]
            if scene == "video" and st.get("video"):
                argv += ["--video", st["video"]]
            argv += ["--audio", ("" if master_done else "+") + bus]
            master_done = True
            if pg["cycle"] and scene not in ("timer", "cover", "video"):
                argv += ["--cycle", str(round(pg["cycle"] * (1 + 0.13 * i), 1)), "--list", loop]
        # Les images demandent une petite police : plus de caractères, plus de détail.
        pfont, psize, px = font, size, 11
        if scene in RICE_ART:
            pfont = "JetBrainsMono Nerd Font"
            # En pixels : la taille en points dépend de la définition annoncée par l'écran.
            px = {"fetch": 12 if n <= 2 else 11 if n <= 6 else 10, "banner": 12, "btop": 11 if n <= 2 else 10}.get(scene, 11 if n <= 2 else 9 if n <= 6 else 8)
        term = ["foot", "--app-id", f"liquid-glass-rice-{page}-{i}", "--title", RICE_SCENES.get(scene, RICE_SPECIAL.get(scene, scene)),
                "-o", f"font={pfont}:pixelsize={px},JetBrainsMono Nerd Font:pixelsize={px}" if scene in RICE_ART else f"font={pfont}:size={psize},JetBrainsMono Nerd Font:size={psize}", "-o", f"colors-dark.alpha={alpha}", "-o", f"colors-light.alpha={alpha}",
                "-o", "pad=6x4 center"]
        pane_alpha = alpha if scene not in RICE_ART else max(alpha, 0.88)     # l'ASCII devient illisible sur un fond chargé
        term = [x.replace(f"alpha={alpha}", f"alpha={pane_alpha}") for x in term]
        if panes is not None and (style != "blanc" or scene in RICE_ART):
            term += ["-o", "colors-dark.background=0c0c12", "-o", "colors-dark.foreground=e6e6eb", "-o", "initial-color-theme=dark"]
            argv = ["env", "LG_DARK=1", *argv]
            if scene == "flame":
                term += ["-o", "colors-dark.background=000000"]
            if pal in RICE_PALETTES:
                acc, alt, bg = RICE_PALETTES[pal]
                argv = ["env", f"LG_PAL={acc}:{alt}", *argv]
                term += ["-o", f"colors-dark.background={bg}", "-o", f"colors-dark.regular1={acc}", "-o", f"colors-dark.regular3={alt}",
                         "-o", f"colors-dark.regular4={acc}", "-o", f"colors-dark.regular2={alt}", "-o", f"colors-dark.regular5={acc}",
                         "-o", f"colors-dark.regular6={alt}"]
        cmd = " ".join(shlex.quote(a) for a in term + argv)
        rules = f'float = true, size = "{int(w)} {int(h)}", move = "{int(x)} {int(y)}", workspace = "{ws} silent"'
        run("hyprctl", "dispatch", f"hl.dsp.exec_cmd({_lua_str(cmd)}, {{ {rules} }})")
        time.sleep(0.06)


def cmd_rice(args: list[str]) -> None:
    """Pages de terminaux animés : sans argument lance la page active ; launch [n], next,
    stop [n], dump, save JSON, reset. Le menu ⌃⌘M (RiceMenu.qml) passe par ces commandes."""
    want = args[0] if args else "launch"
    style = linux_style()
    if want == "dump":
        st = rice_state(style)
        print(json.dumps({**st, "style": style, "label": style_label(style),
                          "scenes": {**RICE_SCENES, **RICE_SPECIAL}, "fonts": RICE_FONTS,
                          "recommended": RICE_STYLES.get(style, RICE_STYLES["gouts"])[3].split(),
                          "themeFont": RICE_STYLES.get(style, RICE_STYLES["gouts"])[0],
                          "layouts": {str(i): rice_grid(i) for i in range(1, 14)},
                          "open": sorted({int(c["class"].split("-")[3]) for c in _rice_clients()})}, ensure_ascii=False))
    elif want == "save":
        rice_save(style, json.loads(args[1]))
    elif want == "reset":
        allp = _rice_all()
        allp.pop(style, None)
        RICE_FILE.write_text(json.dumps(allp, ensure_ascii=False, indent=1))
    elif want == "stop":
        rice_stop(int(args[1]) if len(args) > 1 else None)
    elif want == "next":
        st = rice_state(style)
        rice_launch(st["page"] + 1)
    elif want == "random":
        opts = args[1:]
        ws = int(opts[opts.index("--workspace") + 1]) if "--workspace" in opts else None
        mon = opts[opts.index("--monitor") + 1] if "--monitor" in opts else ""
        count = int(opts[opts.index("--count") + 1]) if "--count" in opts else 0
        if opts and opts[0] in RICE_SIGNED:      # liquid-glass rice random feu
            rice_stop()
            panes, pal, alpha = RICE_SIGNED[opts[0]]
            rice_launch(RICE_RANDOM_PAGE, ws, "--silent" in opts, mon, panes=list(panes), alpha=alpha, pal=pal)
            return
        if "--panes" in opts:      # liste imposée : pour essayer une composition
            rice_launch(RICE_RANDOM_PAGE, ws, "--silent" in opts, mon, panes=opts[opts.index("--panes") + 1].split(","), alpha=0.9, pal=opts[opts.index("--pal") + 1] if "--pal" in opts else "")
            return
        rice_random(ws, "--silent" in opts, mon, count)
    elif want == "launch":
        opts = args[1:]
        ws = int(opts[opts.index("--workspace") + 1]) if "--workspace" in opts else None
        mon = opts[opts.index("--monitor") + 1] if "--monitor" in opts else ""
        pos = [o for o in opts if o.isdigit() and (not ws or o != str(ws))]
        rice_launch(int(pos[0]) if pos else None, ws, "--silent" in opts, mon)
    else:
        sys.exit("usage : liquid-glass rice [random [feu|bleu|wired] | launch [n] | next | stop [n] | dump | save JSON | reset]")


def _wall_tint(path: Path) -> str | None:
    """Teinte dominante d'une image : un mot parmi ceux du carrousel."""
    import colorsys
    size = 40
    out = subprocess.run(["magick", f"{path}[0]", "-resize", f"{size}x{size}!", "-depth", "8", "rgb:-"],
                         capture_output=True, timeout=30).stdout
    if len(out) < size * size * 3:
        return None
    hues, lum, sat = [0.0] * 12, 0.0, 0.0
    for i in range(0, size * size * 3, 3):
        h, s_, v = colorsys.rgb_to_hsv(out[i] / 255, out[i + 1] / 255, out[i + 2] / 255)
        lum += v
        w = s_ * v
        sat += w
        hues[int(h * 12) % 12] += w
    n = size * size
    if sat / n < 0.12:
        return "sombre" if lum / n < 0.5 else "clair"
    return ["rouge", "orange", "jaune", "vert", "vert", "cyan", "cyan", "bleu", "bleu", "violet", "rose", "rose"][hues.index(max(hues))]


def cmd_wall_colors(args: list[str]) -> None:
    """Calcule la teinte de chaque fond une seule fois (cache), pour le filtre du carrousel."""
    from concurrent.futures import ThreadPoolExecutor
    cache = HOME / ".cache/liquid-glass/wall-colors.json"
    try:
        known = json.loads(cache.read_text())
    except (OSError, ValueError):
        known = {}
    roots = [HOME / ".local/share/liquid-glass/wallpapers", *(HOME / ".config/omarchy/themes").glob("*/backgrounds")]
    files = [f for r in roots if r.is_dir() for f in r.iterdir() if f.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp")]
    todo = [f for f in files if str(f) not in known]
    if todo:
        def one(f: Path):
            try:
                return str(f), _wall_tint(f)
            except (OSError, subprocess.SubprocessError):
                return str(f), None
        with ThreadPoolExecutor(2) as ex:
            known.update({k: v for k, v in ex.map(one, todo) if v})
        cache.parent.mkdir(parents=True, exist_ok=True)
        tmp = cache.with_suffix(".tmp")
        tmp.write_text(json.dumps(known))
        tmp.replace(cache)
    print(f"{len(known)} fonds classés.")


def cmd_fetch(args: list[str]) -> None:
    """liquid-glass fetch [--mode ascii|color|image|text] : fiche à la taille du terminal.
    apply : réécrit la fiche du `fastfetch` tapé à la main pour le bureau actif."""
    if args[:1] == ["apply"]:
        cfg = load()
        apply_fastfetch(linux_style(cfg) if cfg.get("profile", {}).get("active") == "linux" else None)
        return
    os.execv(str(REPO / "bin/liquid-glass-fetch"), ["liquid-glass-fetch", *args])


def cmd_ascii(args: list[str]) -> None:
    """liquid-glass ascii [image] [--width N] [--color] [--invert] : image en caractères, dans le
    terminal où tu es. --text "Bonjour" [--font Isometric1] : texte en grand. --fonts : les polices."""
    cols, rows = lg_art.terminal_size()
    opts = list(args)

    def take(flag: str, default: str = "") -> str:
        if flag not in opts:
            return default
        i = opts.index(flag)
        opts.pop(i)
        return opts.pop(i)

    width = int(take("--width", "0")) or cols
    font = take("--font")
    text = take("--text")
    if "--fonts" in opts:
        print("\n".join(lg_art.fonts()))
        return
    if text:
        lines, used = lg_art.banner(text, width if not font else 0, font)
        print("\n".join(lines))
        print(f"\x1b[2m{used.replace('_', ' ')}\x1b[0m", file=sys.stderr)
        return
    color, invert = "--color" in opts, True if "--invert" in opts else None
    names = [o for o in opts if not o.startswith("--")]
    src = Path(names[0]).expanduser() if names else random.choice(lg_art.gallery())
    if not src.exists():
        sys.exit(f"image introuvable : {src}")
    probe = run("magick", "identify", "-format", "%w %h", str(src) + "[0]").stdout.split()
    ratio = int(probe[1]) / int(probe[0]) if len(probe) == 2 else 1
    print("\n".join(lg_art.render(src, width, max(4, int(width * ratio / 2)), color, "", invert)))


def cmd_export(args: list[str]) -> None:
    """Copie tes réglages et ta liste d'applications dans state/, pour ./install.sh --restore."""
    out = REPO / "state"
    out.mkdir(exist_ok=True)
    for f in ("config.toml", "rice.json", "linux-layout.json"):
        if (CONF_DIR / f).exists():
            shutil.copy2(CONF_DIR / f, out / f)
    (out / "packages.txt").write_text(run("pacman", "-Qqen").stdout)
    (out / "aur.txt").write_text(run("pacman", "-Qqem").stdout)
    print(f"Réglages et applications enregistrés dans {out}")




def write_lang(lang: str, roots: list[Path]) -> None:
    """Écrit T.js dans chaque plugin. Omarchy recharge un plugin dont un fichier change,
    le changement de langue est donc immédiat."""
    if lang == "en":
        rows = [ln.split("\t", 1) for ln in (REPO / "shared/lang/en.tsv").read_text().splitlines() if "\t" in ln]
        body = (f'var loc = "en_US"\nvar d = {json.dumps(dict(rows), ensure_ascii=False)}\n'
                "function t(s) { return d[s] !== undefined ? d[s] : s }\n")
    else:
        body = 'var loc = "fr_FR"\nfunction t(s) { return s }\n'
    for root in roots:
        for plugin in root.glob("liquid-glass.*"):
            if (plugin / "T.js").exists():
                (plugin / "T.js").write_text(".pragma library\n" + body)


def cmd_lang(args: list[str]) -> None:
    """liquid-glass lang [fr|en] : langue des bureaux, du sélecteur et des Réglages."""
    if not args:
        print(load().get("linux", {}).get("lang", "fr"))
        return
    if args[0] not in ("fr", "en"):
        sys.exit("usage : liquid-glass lang fr|en")
    set_key("linux.lang", args[0])
    write_lang(args[0], [CONF_DIR.parent / "omarchy/plugins"])
    apply_fastfetch(linux_style() if load().get("profile", {}).get("active") == "linux" else None)
    print("Langue : " + args[0])


KEYS_UNIT = "liquid-glass-keys.service"


def cmd_keys(args: list[str]) -> None:
    """Son de clavier « creamy » : on | off | test | status | import DOSSIER."""
    want = args[0] if args else "status"
    unit_dir = HOME / ".config/systemd/user"
    unit = unit_dir / KEYS_UNIT
    if want in ("on", "off"):
        if want == "on":
            unit_dir.mkdir(parents=True, exist_ok=True)
            unit.write_text(
                "[Unit]\nDescription=Liquid Glass — son de clavier\nAfter=graphical-session.target pipewire.service\n"
                "PartOf=graphical-session.target\n\n[Service]\n"
                f"ExecStart={REPO / 'bin/liquid-glass-keys'}\nRestart=on-failure\nRestartSec=3\nNice=-2\n\n"
                "[Install]\nWantedBy=graphical-session.target\n")
            run("systemctl", "--user", "daemon-reload")
            run("systemctl", "--user", "enable", "--now", KEYS_UNIT)
        else:
            run("systemctl", "--user", "disable", "--now", KEYS_UNIT)
        set_key("keys.sound", "true" if want == "on" else "false")
        write_json(load())
        print("Son du clavier " + ("activé." if want == "on" else "coupé."))
    elif want == "test":
        run(str(REPO / "bin/liquid-glass-keys"), "test", quiet=False)
    elif want == "import" and len(args) > 1:
        run(str(REPO / "bin/liquid-glass-keys"), "import", args[1], quiet=False)
    else:
        active = run("systemctl", "--user", "is-active", KEYS_UNIT).stdout.strip() if unit.exists() else "absent"
        print(json.dumps({"service": active, "source": "Hyprland (sans groupe input)",
                          "pack": load().get("keys", {}).get("sound_pack", "auto")}, ensure_ascii=False))


COMMANDS = {
    "keys": cmd_keys,
    "rice": cmd_rice,
    "export": cmd_export,
    "ascii": cmd_ascii,
    "fetch": cmd_fetch,
    "lang": cmd_lang,
    "wall-colors": cmd_wall_colors,
    "profile": cmd_profile,
    "login-item": cmd_login_item,
    "tile-menu": cmd_tile_menu,
    "resume-music": cmd_resume_music,
    "bar-contrast": cmd_bar_contrast,
    "key": cmd_key,
    "window": cmd_window,
    "focus": cmd_focus,
    "gamemode": cmd_gamemode,
    "animated-wallpapers": cmd_animated_wallpapers,
    "bar": cmd_bar,
    "wallpapers": cmd_wallpapers,
    "apply": cmd_apply,
    "mode": cmd_mode,
    "auto-tick": cmd_auto_tick,
    "system": cmd_system,
    "set": cmd_set,
    "get": cmd_get,
    "status": cmd_status,
    "show-desktop": cmd_show_desktop,
    "hotcorner": cmd_hotcorner,
}


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    fn = COMMANDS.get(sys.argv[1])
    if not fn:
        sys.exit(f"commande inconnue : {sys.argv[1]}\n{__doc__}")
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()

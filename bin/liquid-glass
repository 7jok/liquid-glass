WALL_DIR = Path.home() / ".local/share/liquid-glass/wallpapers"
# (catégorie, requête wallhaven, catégories 1=général 2=anime 3=personnes, nombre)
WALL_QUERIES = [
    ("anime", "death note", "010", 10),
    ("anime", "anime minimalism", "010", 14),

def _wall_fetch() -> None:
    import concurrent.futures
    import time
    import urllib.parse
    import urllib.request
    WALL_DIR.mkdir(parents=True, exist_ok=True)
    have = {p.stem.rsplit("-", 1)[-1] for p in WALL_DIR.glob("*.jpg")}
    # Fonds écartés à la main (un id wallhaven par ligne) : jamais retéléchargés.
    ignore = WALL_DIR / ".ignore"
    if ignore.exists():
        have |= {l.strip() for l in ignore.read_text().splitlines() if l.strip()}
    ua = {"User-Agent": "liquid-glass-wallpapers/1.0"}
    todo: list[tuple[str, str]] = []
    seen: set[str] = set()
    for cat, query, cats, count in WALL_QUERIES:
        params = urllib.parse.urlencode({"q": query, "categories": cats, "purity": "100", "atleast": "1920x1080",
                                         "ratios": "16x9,16x10", "sorting": "favorites", "order": "desc"})
        try:
            req = urllib.request.Request("https://wallhaven.cc/api/v1/search?" + params, headers=ua)
            data = json.load(urllib.request.urlopen(req, timeout=20))["data"]
        except Exception as e:  # réseau, quota…
            print(f"  {query} : {e}", file=sys.stderr)
            time.sleep(3)
            continue
        n = 0
        for w in data:
            if n >= count:
                break
            if w.get("purity") != "sfw" or w["id"] in seen:
                continue
            seen.add(w["id"])
            n += 1
            if w["id"] not in have:
                todo.append((cat, w))
        time.sleep(1.6)  # quota de l'API : 45 requêtes / minute

    def grab(item):
        cat, w = item
        slug = re.sub(r"[^a-z0-9]+", "-", (w.get("category") or cat).lower()).strip("-")
        dest = WALL_DIR / f"{cat}-{w['id']}.jpg"
        raw = dest.with_suffix(".part")
        try:
            req = urllib.request.Request(w["path"], headers=ua)
            raw.write_bytes(urllib.request.urlopen(req, timeout=60).read())
            # 2560 px de large au plus, JPEG 88 : assez net en 1080p, quatre fois plus léger.
            subprocess.run(["magick", str(raw), "-resize", "2560x1600>", "-quality", "88", str(dest)], check=True)
            return f"  + {dest.name}"
        except Exception as e:
            return f"  ! {w['id']} : {e}"
        finally:
            raw.unlink(missing_ok=True)

    print(f"{len(todo)} fonds à télécharger…")
    with concurrent.futures.ThreadPoolExecutor(4) as ex:
        for line in ex.map(grab, todo):
            print(line, flush=True)


# Fonds générés : vagues de papier découpé (calques décalés, ombre portée) et
# taches de couleur floutées, chacun dans sa propre palette.
GEN_PALETTES = [
    ("sauge", ["#9db3a6", "#6f8c7c", "#4b6b5c", "#2c4a3e", "#132820"]),
    ("lavande", ["#a7a3d6", "#7c77b9", "#56519a", "#332f73", "#17143f"]),
    ("corail", ["#ffd2c2", "#ff9f87", "#f26b5b", "#c2414b", "#6e2236"]),
    ("ocean", ["#b9e3f0", "#6fc0de", "#2f8fc0", "#1c5e94", "#0c2f57"]),

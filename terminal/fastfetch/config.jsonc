// Liquid Glass — fastfetch. Logo en pixel art (goutte de verre en blocs █),
// généré par scripts/gen-fastfetch-logo.py. Couleurs 24 bits : identiques
// quel que soit le thème du terminal, et ça marche aussi dans tmux/ssh.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;255;255;255",
      "2": "38;2;200;244;255",
      "3": "38;2;111;216;255",
      "4": "38;2;47;163;255",
      "5": "38;2;79;108;247",
      "6": "38;2;159;230;255",
      "7": "38;2;59;47;181"
    },
    "padding": { "top": 1, "left": 3, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" },
    "key": { "width": 13 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
    { "type": "os", "key": "󰣇  OS", "format": "{pretty-name}" },
    { "type": "kernel", "key": "󰌽  Noyau" },
    { "type": "uptime", "key": "󰅐  Allumé" },
    { "type": "packages", "key": "󰏖  Paquets" },
    { "type": "wm", "key": "󰍹  Bureau", "format": "{pretty-name} · Liquid Glass" },
    { "type": "terminal", "key": "󰆍  Terminal" },
    { "type": "shell", "key": "󱆃  Shell" },
    { "type": "font", "key": "󰊄  Police" },
    { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
    { "type": "cpu", "key": "󰻠  CPU", "format": "{name} ({cores-logical})" },
    { "type": "gpu", "key": "󰢮  GPU", "format": "{name}" },
    { "type": "memory", "key": "󰍛  Mémoire" },
    { "type": "disk", "key": "󰋊  Disque", "folders": "/" },
    { "type": "battery", "key": "󰁹  Batterie" },
    { "type": "media", "key": "󰎆  Musique", "format": "{artist} — {title}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}

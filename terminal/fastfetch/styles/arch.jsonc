{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 15
    },
    "color": {
      "keys": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "os",
      "key": " os",
      "format": "Arch Linux · sur {pretty-name}"
    },
    {
      "type": "kernel",
      "key": " noyau"
    },
    {
      "type": "wm",
      "key": " bureau",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": " paquets"
    },
    {
      "type": "uptime",
      "key": " allumé"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " mémoire"
    },
    {
      "type": "disk",
      "key": " disque",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": " batterie"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}

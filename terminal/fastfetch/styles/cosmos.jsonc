{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "  ▄▄██▄▄  \n ██▓▒░▒██ \n███▒░ ░▓██\n ██▓░▒▓██ \n  ▀▀██▀▀  ",
    "padding": {
      "top": 2,
      "left": 3,
      "right": 4
    },
    "color": {
      "1": "blue"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 16
    },
    "color": {
      "keys": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "os",
      "key": "◦ orbite",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "◦ noyau"
    },
    {
      "type": "wm",
      "key": "◦ vaisseau",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "◦ cargo"
    },
    {
      "type": "uptime",
      "key": "◦ en vol"
    },
    {
      "type": "custom",
      "format": "· · ·"
    },
    {
      "type": "cpu",
      "key": "◦ moteur",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "◦ mémoire"
    },
    {
      "type": "disk",
      "key": "◦ soute",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "◦ énergie"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "▰▰▰▰▰▰▱\n ▰▰▰▰▰▱\n  ▰▰▰▰▱\n ▰▰▰▰▰▱\n▰▰▰▰▰▰▱",
    "padding": {
      "top": 2,
      "left": 3,
      "right": 4
    },
    "color": {
      "1": "blue"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 16
    },
    "color": {
      "keys": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "▰▰▰▰▰▰▰▰▰▰▰▰▰▰"
    },
    {
      "type": "os",
      "key": "▸ OS",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "▸ NOYAU"
    },
    {
      "type": "wm",
      "key": "▸ BUREAU",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "▸ PAQUETS"
    },
    {
      "type": "uptime",
      "key": "▸ ALLUMÉ"
    },
    {
      "type": "cpu",
      "key": "▸ CPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "▸ MÉMOIRE"
    },
    {
      "type": "disk",
      "key": "▸ DISQUE",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "▸ BATTERIE"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}

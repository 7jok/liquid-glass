{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": " ▄▄  ▄▄ \n████████\n ██████ \n  ████  \n   ██   ",
    "padding": {
      "top": 2,
      "left": 3,
      "right": 4
    },
    "color": {
      "1": "blue"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 16
    },
    "color": {
      "keys": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "os",
      "key": "♡ os",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "♡ noyau"
    },
    {
      "type": "wm",
      "key": "♡ bureau",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "♡ paquets"
    },
    {
      "type": "uptime",
      "key": "♡ allumé"
    },
    {
      "type": "custom",
      "format": "· · · · ·"
    },
    {
      "type": "cpu",
      "key": "♡ cpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "♡ mémoire"
    },
    {
      "type": "disk",
      "key": "♡ disque",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "♡ batterie"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}

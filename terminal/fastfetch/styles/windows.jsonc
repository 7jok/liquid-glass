{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "windows",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 14
    },
    "color": {
      "keys": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "os",
      "key": "Système",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "Noyau"
    },
    {
      "type": "wm",
      "key": "Bureau",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "Paquets"
    },
    {
      "type": "uptime",
      "key": "Allumé"
    },
    {
      "type": "cpu",
      "key": "Processeur",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Mémoire"
    },
    {
      "type": "disk",
      "key": "Disque",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "Batterie"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
